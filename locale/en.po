msgid "Flammenturm"
msgstr "Flame Tower"

#: src/data.gd:201
msgid "Kurzer Feuerstrahl, ideal hinter Mauern."
msgstr "Short jet of fire, ideal behind walls."

#: src/data.gd:202
msgid "Mörser"
msgstr "Mortar"

#: src/data.gd:203
msgid "Bogenschuss mit großem Flächenschaden."
msgstr "Lobbed shot with big area damage."

