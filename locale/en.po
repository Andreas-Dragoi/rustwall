msgstr "Passage"

#: src/exp_world.gd:119
msgid "Rand"
msgstr "Edge"

#: src/exp_world.gd:618
msgid "Am Ende des Regenbogens steht ein Münztopf!"
msgstr "At the end of the rainbow there's a pot of coins!"

#: src/exp_world.gd:652
msgid "Die Flut kommt zurück! Am Wasser kommst du nur langsam voran."
msgstr "The tide is coming back! You move slowly near the water."

#: src/exp_world.gd:818
msgid "Wahrzeichen entdeckt: %s!%s"
msgstr "Landmark discovered: %s!%s"

#: src/exp_world.gd:818
msgid "Eine Tagebuchseite lag dort."
msgstr "A journal page was lying there."

#: src/exp_world.gd:855
msgid "Tagebuch: %s"
msgstr "Journal: %s"

#: src/exp_world.gd:856
msgid "Tagebuchseite „%s“ gefunden – lesen im Tagebuch (Weltkarte)."
msgstr "Journal page “%s” found – read it in the journal (world map)."

#: src/exp_world.gd:945
msgid "Eine Händler-Karawane zieht durch das Gebiet – sie verkauft Werkzeug und Eier."
msgstr "A trader caravan is passing through the area – it sells tools and eggs."

#: src/exp_world.gd:964
msgid "Zu wenig Feldmünzen (%d nötig)"
msgstr "Not enough field coins (%d needed)"

#: src/exp_world.gd:969
msgid "Das Werkzeug hast du schon"
msgstr "You already have that tool"

