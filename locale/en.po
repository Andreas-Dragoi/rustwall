msgid "Begleiter-Ei"
msgstr "Companion Egg"

#: src/exp_world.gd:1003
msgid "Schlüpft nach %d Stunden im Nest der Basis."
msgstr "Hatches after %d hours in the base's nest."

#: src/exp_world.gd:1004
msgid "Seltene Ladung"
msgstr "Rare Cargo"

#: src/exp_world.gd:1005
msgid "%d Treibstoff"
msgstr "%d fuel"

#: src/exp_world.gd:1018
