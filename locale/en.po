msgid "Entdecke %s Gegnerarten"
msgstr "Discover %s enemy types"

#: src/data.gd:192 src/screens/garderobe.gd:15
msgid "Bunker"
msgstr "Bunker"

#: src/data.gd:193
msgid "Das Herz der Basis. Seine Stufe bestimmt, was gebaut werden darf."
msgstr "The heart of the base. Its level decides what you may build."

#: src/data.gd:194
msgid "MG-Turm"
msgstr "MG Tower"

#: src/data.gd:195
msgid "Schnelles Feuer gegen einzelne Gegner."
msgstr "Rapid fire against single enemies."

#: src/data.gd:196
msgid "Kanone"
msgstr "Cannon"

#: src/data.gd:197
msgid "Langsamer, starker Schuss mit Flächenschaden."
msgstr "Slow, strong shot with area damage."

#: src/data.gd:198
msgid "Wachturm"
msgstr "Watchtower"

#: src/data.gd:199
msgid "Ein Schütze trifft weit entfernte, starke Gegner."
msgstr "A marksman hits strong enemies far away."

