msgstr "No room for another egg (at most %d)"

#: src/exp_world.gd:978
msgid "Ein Begleiter-Ei! Es schlüpft im Nest der Basis (Bildschirm „Begleiter“)."
msgstr "A companion egg! It hatches in the base's nest (“Companions” screen)."

#: src/exp_world.gd:982 src/exp_world.gd:986
msgid "Der Rucksack ist voll"
msgstr "The backpack is full"

#: src/exp_world.gd:989 src/helden.gd:157
msgid "Unbekannt"
msgstr "Unknown"

