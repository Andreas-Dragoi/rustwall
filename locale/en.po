msgid "Löschzug"
msgstr "Fire Brigade"

#: src/data_helden.gd:19
msgid "Feuerwehrhelm"
msgstr "Fire helmet"

#: src/data_helden.gd:19
msgid "Brandschutzjacke"
msgstr "Fireproof jacket"

#: src/data_helden.gd:19
msgid "Florian-Medaille"
msgstr "Florian medal"

#: src/data_helden.gd:21
msgid "+25 % Brenndauer"
msgstr "+25 % burn duration"

#: src/data_helden.gd:21
msgid "Feuer-Waffen +15 % Schaden, +8 % Leben"
msgstr "Fire weapons +15 % damage, +8 % health"

#: src/data_helden.gd:22
msgid "Baustelle"
msgstr "Construction Site"

#: src/data_helden.gd:23
msgid "Bauhelm mit Lampe"
msgstr "Hard hat with lamp"

#: src/data_helden.gd:23
msgid "Warnweste"
msgstr "Safety vest"

#: src/data_helden.gd:23
msgid "Wasserwaage"
msgstr "Spirit level"

#: src/data_helden.gd:25
msgid "+10 % Turmschaden in der Nähe"
msgstr "+10 % tower damage nearby"

#: src/data_helden.gd:25
msgid "+12 % Leben, +15 % Heilung"
msgstr "+12 % health, +15 % healing"

#: src/data_helden.gd:26
msgid "Tüftlerin"
msgstr "Tinkerer"

#: src/data_helden.gd:27
msgid "Schweißerhaube"
msgstr "Welding hood"

#: src/data_helden.gd:27
msgid "Laborkittel"
msgstr "Lab coat"

#: src/data_helden.gd:27
msgid "Zahnrad-Anhänger"
msgstr "Gear pendant"

#: src/data_helden.gd:29
msgid "Fähigkeiten laden 8 % schneller"
msgstr "Abilities recharge 8 % faster"

#: src/data_helden.gd:29
msgid "+20 % Spezialfähigkeit, Blitz-Waffen +10 % Schaden"
msgstr "+20 % special ability, lightning weapons +10 % damage"

#: src/data_helden.gd:30
msgid "Kundschafter"
msgstr "Scout"

#: src/data_helden.gd:31
