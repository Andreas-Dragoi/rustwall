msgid "Erzeugt Metall über Zeit."
msgstr "Produces metal over time."

#: src/data.gd:230
msgid "Raffinerie"
msgstr "Refinery"

#: src/data.gd:231
msgid "Erzeugt Treibstoff über Zeit."
msgstr "Produces fuel over time."

#: src/data.gd:232
msgid "Generator"
msgstr "Generator"

#: src/data.gd:233
msgid "Erzeugt Energiezellen über Zeit."
msgstr "Produces energy cells over time."

#: src/data.gd:234
msgid "Lager"
msgstr "Storage"

#: src/data.gd:235
msgid "Erhöht die Obergrenze für Rohstoffe."
msgstr "Raises the resource limit."

#: src/data.gd:236
msgid "Quartier"
msgstr "Quarters"

#: src/data.gd:237
msgid "Helden auswählen, ausrüsten, Talente verteilen."
msgstr "Choose heroes, equip them, assign talents."

#: src/data.gd:238
msgid "Kistenlager"
msgstr "Crate Depot"

#: src/data.gd:239
msgid "Hier werden Beutekisten geöffnet."
msgstr "Loot crates are opened here."

#: src/data.gd:240 src/hud.gd:325 src/hud_guide.gd:14 src/screens.gd:38
msgid "Werkstatt"
msgstr "Workshop"

#: src/data.gd:241
msgid "Waffen verbessern, zerlegen und verschmelzen."
msgstr "Upgrade, dismantle and merge weapons."

#: src/data.gd:242 src/data.gd:860 src/hud.gd:326 src/hud_guide.gd:15
msgid "Garage"
msgstr "Garage"

#: src/data.gd:243
msgid "Fahrzeuge freischalten und verbessern."
msgstr "Unlock and upgrade vehicles."

#: src/data.gd:244 src/screens.gd:38
msgid "Funkturm"
msgstr "Radio Tower"

#: src/data.gd:245
msgid "Freunde, Post und Ranglisten."
msgstr "Friends, mail and leaderboards."

#: src/data.gd:246
msgid "Clanhalle"
msgstr "Clan Hall"

#: src/data.gd:247
msgid "Clan gründen oder beitreten."
msgstr "Found or join a clan."

#: src/data.gd:248
msgid "Labor"
msgstr "Lab"

#: src/data.gd:249
msgid "Talente und Kommandanten-Punkte neu verteilen."
msgstr "Reassign talents and commander points."

#: src/data.gd:250
msgid "Trainingsplatz"
msgstr "Training Ground"

#: src/data.gd:251
msgid "Ein Held, der gerade nicht gespielt wird, sammelt hier Erfahrung."
msgstr "A hero who isn't being played gains experience here."

#: src/data.gd:252
msgid "Warmes Licht für die Basis."
msgstr "Warm light for the base."

#: src/data.gd:253
msgid "Flagge"
msgstr "Flag"

#: src/data.gd:253
msgid "Zeigt deine Farbe."
msgstr "Shows your color."

#: src/data.gd:254
msgid "Blumenbeet"
msgstr "Flower Bed"

#: src/data.gd:254
msgid "Macht die Basis freundlicher."
msgstr "Makes the base friendlier."

#: src/data.gd:255
msgid "Heldenstatue"
msgstr "Hero Statue"

#: src/data.gd:255
msgid "Zu Ehren deiner Helden."
msgstr "In honor of your heroes."

#: src/data.gd:257
msgid "Teergrube"
msgstr "Tar Pit"

#: src/data.gd:258
msgid "Zäher Teer bremst Gegner um 70 %. Läuft ein Brennender hinein, fängt die Grube Feuer."
msgstr "Sticky tar slows enemies by 70 %. If a burning enemy walks in, the pit catches fire."

#: src/data.gd:259
msgid "Federbrett"
msgstr "Spring Board"

#: src/data.gd:260
msgid "Schleudert Gegner zurück (alle 3 s). Brocken und Bosse sind zu schwer."
msgstr "Flings enemies back (every 3 s). Brutes and bosses are too heavy."

#: src/data.gd:261
msgid "Lockköder"
msgstr "Lure Bait"

#: src/data.gd:262
msgid "Lockt Gegner im Umkreis von 14 m für 8 s an – dreimal pro Flut."
msgstr "Lures enemies within 14 m for 8 s – three times per flood."

#: src/data.gd:263
msgid "Elektrozaun"
msgstr "Electric Fence"

#: src/data.gd:264
msgid "Schlägt alle 1,5 s Funken: Blitzschaden und kurze Betäubung. Hält 40 Entladungen pro Flut."
msgstr "Sparks every 1.5 s: lightning damage and a short stun. Lasts 40 discharges per flood."

#: src/data.gd:265
msgid "Eisfalle"
msgstr "Ice Trap"

#: src/data.gd:266
msgid "Friert alle Gegner im Umkreis von 2,5 m für 2,5 s ein und lädt 8 s nach. Eiswesen bleiben unberührt."
msgstr "Freezes all enemies within 2.5 m for 2.5 s and recharges for 8 s. Ice creatures are unaffected."

#: src/data.gd:268
msgid "Gartenbank"
msgstr "Garden Bench"

#: src/data.gd:268
msgid "Hier ruhen sich die Bewohner aus."
msgstr "Villagers rest here."

#: src/data.gd:269
msgid "Gartenzaun"
msgstr "Garden Fence"

