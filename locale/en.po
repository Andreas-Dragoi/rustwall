msgstr "Tool missing: %s"

#: src/exp_world.gd:1241
msgid "%s: Dafür brauchst du „%s“ – von der Händler-Karawane oder als Lohn der Nebenquest."
msgstr "%s: You need “%s” for this – from the trader caravan or as a side-quest reward."

#: src/expedition.gd:765
msgid "Eingelagert!"
msgstr "Stored!"

#: src/expedition.gd:780
msgid "Die Zentrale steht – alle Bauplätze sind frei. Achtung, Angriffe!"
msgstr "The headquarters is up – all building spots are open. Watch out, attacks!"

#: src/expedition.gd:789
msgid "Außenbasis Stufe %d!"
msgstr "Outpost level %d!"

#: src/expedition.gd:828
msgid "Großangriff! Halte die Zentrale %d Sekunden."
msgstr "Onslaught! Hold the headquarters for %d seconds."

#: src/expedition.gd:843
msgid "Ein Elitegegner greift an!"
msgstr "An elite enemy is attacking!"

#: src/expedition.gd:857
msgid "Die Außenbasis steht! Die Sperren lösen sich auf."
msgstr "The outpost is up! The barriers dissolve."

#: src/expedition.gd:952
msgid "Dein Held ist erschöpft – nur das Depot und der halbe Rucksack kommen heim."
msgstr "Your hero is exhausted – only the depot and half the backpack make it home."

#: src/expedition.gd:955
msgid "Wiedereinstieg in %d s (noch %d×). Der Rucksack hat %s verloren."
msgstr "Back in %d s (%d× left). The backpack lost %s."

#: src/expedition.gd:955
msgid "die Hälfte"
msgstr "half"

#: src/expedition.gd:962
msgid "Die Zentrale ist gefallen! In %d s kann sie wieder aufgebaut werden."
msgstr "The headquarters has fallen! It can be rebuilt in %d s."

#: src/expedition.gd:1027
msgid "Und ein Begleiter-Ei!"
msgstr "And a companion egg!"

#: src/expedition.gd:1051
msgid "Sammle Münzen und Rohstoffe, dann stell dich auf den Bauplatz der Zentrale"
msgstr "Collect coins and resources, then stand on the headquarters' building spot"

#: src/expedition.gd:1052
msgid "Sammle Münzen und Rohstoffe"
msgstr "Collect coins and resources"

#: src/expedition.gd:1055
msgid "Angriff in %d s!"
msgstr "Attack in %d s!"

#: src/expedition.gd:1060
msgid "Baue die Außenbasis: noch %d Pflichtplätze"
msgstr "Build the outpost: %d required spots left"

#: src/expedition.gd:1063
msgid "Großangriff! Halte durch: %s"
msgstr "Onslaught! Hold on: %s"

#: src/expedition.gd:1064
msgid "Besiege den Elitegegner!"
msgstr "Defeat the elite enemy!"

#: src/expedition.gd:1066
msgid "Befreiung: Welle %d von %d – %s"
msgstr "Liberation: wave %d of %d – %s"

#: src/expedition.gd:1068
msgid "Erkunde das Gebiet · Depot: %d Ladungen"
msgstr "Explore the area · Depot: %d loads"

