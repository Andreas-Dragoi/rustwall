msgstr "· Dusk %d"

#: src/expedition.gd:1072
msgid "· Dämmerung in %s"
msgstr "· Dusk in %s"

#: src/expedition.gd:1246
msgid "Rucksack voll!"
msgstr "Backpack full!"

#: src/expedition.gd:1342
msgid "Rucksack voll! Wirf etwas ab"
msgstr "Backpack full! Drop something"

#: src/expedition.gd:1487
msgid "Ein Angriff naht!"
msgstr "An attack is coming!"

#: src/expedition.gd:1502
msgid "Die Außenbasis ist befreit – ihr Vorteil wirkt wieder!"
msgstr "The outpost is liberated – its bonus works again!"

#: src/expedition.gd:1517
msgid "Es wird dunkel: Gegner +%d %%, Beute +%d %%"
msgstr "It's getting dark: enemies +%d %%, loot +%d %%"

#: src/flood_weather.gd:80
msgid "Die Nachteile wirken nur halb so stark."
msgstr "The drawbacks are only half as strong."

#: src/flood_weather.gd:87
msgid "%s, Nacht"
msgstr "%s, night"

#: src/flood_weather.gd:110
msgid "Wetter der Flut: %s"
msgstr "Flood weather: %s"

#: src/guide.gd:97
msgid "Tutorial geschafft! Die Ziele-Leiste zeigt dir, wie es weitergeht."
msgstr "Tutorial complete! The goals bar shows you how to continue."

#: src/guide.gd:229
msgid "Ziel: %s"
msgstr "Goal: %s"

#: src/guide.gd:255 src/liveops.gd:522 src/screens/hilfe.gd:143
