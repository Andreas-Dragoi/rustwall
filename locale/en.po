msgstr "the ember core in his chest"

#: src/data.gd:768
msgid "Herrscher der Stadtruinen"
msgstr "Ruler of the City Ruins"

#: src/data.gd:768
msgid "der Sternsplitter-Akku in der Brust"
msgstr "the star-shard battery in its chest"

