msgstr "World Boss"

#: src/data.gd:766
msgid "die Kiemen"
msgstr "the gills"

#: src/data.gd:767
msgid "Herrscher der Vulkaninsel"
msgstr "Ruler of Volcano Isle"

#: src/data.gd:767
