msgid "Tesla-Spule"
msgstr "Tesla Coil"

#: src/data.gd:205
msgid "Kettenblitz über mehrere Gegner, verlangsamt."
msgstr "Chain lightning across several enemies, slows them."

#: src/data.gd:206
msgid "Raketenturm"
msgstr "Rocket Tower"

#: src/data.gd:207
msgid "Gegen Brocken und Bosse."
msgstr "Against brutes and bosses."

#: src/data.gd:208
msgid "Schildgenerator"
msgstr "Shield Generator"

#: src/data.gd:209
msgid "Halbiert den Schaden an allen Gebäuden im Umkreis von 8 Feldern."
msgstr "Halves damage to all buildings within 8 tiles."

#: src/data.gd:210
msgid "Eiskanone"
msgstr "Ice Cannon"

#: src/data.gd:211
msgid "Friert Gruppen für 2 Sekunden ein."
msgstr "Freezes groups for 2 seconds."

#: src/data.gd:212
msgid "Luftabwehr"
msgstr "Anti-Air"

#: src/data.gd:213
msgid "Nur gegen fliegende Schleimlinge, dafür sehr stark."
msgstr "Only against flying slimelings, but very strong."

#: src/data.gd:214
msgid "Mauer"
msgstr "Wall"

#: src/data.gd:215
msgid "Sperrt Gegner, Helden und Fahrzeuge. Aus Holz; ab Bunker 4 zu Stein, ab Bunker 7 zu Metall verbesserbar."
msgstr "Blocks enemies, heroes and vehicles. Made of wood; upgradable to stone from bunker 4 and to metal from bunker 7."

#: src/data.gd:216 src/data.gd:1472
msgid "Tor"
msgstr "Gate"

#: src/data.gd:217
msgid "Öffnet sich für Helden, Bewohner und Fahrzeuge. Für Gegner ist es eine Mauer."
msgstr "Opens for heroes, villagers and vehicles. For enemies it's a wall."

#: src/data.gd:218
msgid "Stachelfalle"
msgstr "Spike Trap"

#: src/data.gd:219
msgid "Schadet allen, die darüberlaufen. Hält 30 Auslösungen pro Flut."
msgstr "Hurts everyone who walks over it. Lasts 30 triggers per flood."

#: src/data.gd:220
msgid "Klebefalle"
msgstr "Glue Trap"

#: src/data.gd:221
msgid "Verlangsamt alle Gegner auf der Fläche stark."
msgstr "Strongly slows all enemies on the area."

#: src/data.gd:222
msgid "Sprengmine"
msgstr "Blast Mine"

#: src/data.gd:223
msgid "Explodiert einmal pro Flut mit großem Radius."
msgstr "Explodes once per flood with a large radius."

#: src/data.gd:224
msgid "Sägewerk"
msgstr "Sawmill"

#: src/data.gd:225
msgid "Erzeugt Holz über Zeit."
msgstr "Produces wood over time."

#: src/data.gd:226
msgid "Steinbruch"
msgstr "Quarry"

#: src/data.gd:227
msgid "Erzeugt Stein über Zeit."
msgstr "Produces stone over time."

#: src/data.gd:228
msgid "Schrottpresse"
msgstr "Scrap Press"

