#: src/data_fuehrung.gd:139 src/data_modi.gd:35
msgid "Erste Schritte"
msgstr ""

#: src/data_fuehrung.gd:140
msgid "Worum geht es?"
msgstr ""

#: src/data_fuehrung.gd:140
msgid "Du bist Kommandant eines Bunkers. Baue deine Basis aus, sammle Rohstoffe auf Expeditionen und halte an jedem siebten Tag die Flut der Schleimlinge auf."
msgstr ""

#: src/data_fuehrung.gd:141
msgid "Ziele-Leiste"
msgstr ""

#: src/data_fuehrung.gd:141
msgid "Links oben steht immer dein nächstes Ziel mit Belohnung. Ist es erfüllt, tippe auf „Abholen“ – danach erscheint das nächste."
msgstr ""

#: src/data_fuehrung.gd:142
msgid "Tutorial"
msgstr ""

#: src/data_fuehrung.gd:142
msgid "Das Tutorial führt dich mit einem Zeigefinger durch die ersten Schritte. Jeden Schritt kannst du einzeln überspringen und unter „Bedienung“ neu starten."
msgstr ""

#: src/data_fuehrung.gd:143 src/screens/settings.gd:125
msgid "Steuerung am Handy"
msgstr ""

#: src/data_fuehrung.gd:143
msgid "Linker Daumen: laufen. Gebäude antippen: verbessern, verschieben, abholen. Zwei Finger oder die Knöpfe + und −: zoomen."
msgstr ""

#: src/data_fuehrung.gd:144 src/screens/settings_q.gd:131
msgid "Steuerung am PC"
msgstr ""

#: src/data_fuehrung.gd:144
msgid "W A S D: laufen · Q, E, R: Fähigkeiten · F: Kommandant · Leertaste: ausweichen · T: Fahrzeug · N: nächste Welle · Esc: Pause."
msgstr ""

#: src/data_fuehrung.gd:145
msgid "Elemente und Schwächen"
msgstr ""

#: src/data_fuehrung.gd:146
msgid "Elemente"
msgstr ""

#: src/data_fuehrung.gd:146
msgid "Viele Waffen und Türme tragen ein Element: Feuer, Eis, Blitz, Gift, Wasser oder Explosion. Jede Gegnerfamilie reagiert anders darauf."
msgstr ""

#: src/data_fuehrung.gd:147
msgid "Stark und schwach"
msgstr ""

#: src/data_fuehrung.gd:147
msgid "+50 % heißt: der Treffer zählt anderthalbfach. „Wirkungslos“ heißt: dieses Element richtet keinen Schaden an. Die Tabelle unten zeigt jede Familie."
msgstr ""

#: src/data_fuehrung.gd:148
msgid "Brennen und Gift"
msgstr ""

#: src/data_fuehrung.gd:148
msgid "Feuer setzt in Brand, Gift wirkt über einige Sekunden. Beides stapelt sich nicht, wird aber erneuert."
msgstr ""

#: src/data_fuehrung.gd:149
msgid "Waffenarten"
msgstr ""

#: src/data_fuehrung.gd:150
msgid "15 Waffen je Held"
msgstr ""

#: src/data_fuehrung.gd:150
msgid "Jeder Held hat 15 Waffen: drei Startwaffen (Heldenstufe 1, 8, 16) und zwölf weitere aus Funden oder Bauplänen. Die Helden-Seite zeigt alle – auch die gesperrten mit Hinweis, wo es sie gibt."
msgstr ""

#: src/data_fuehrung.gd:151 src/screens/heroes.gd:283
msgid "Schnellwechsel"
msgstr ""

#: src/data_fuehrung.gd:151
msgid "Auf der Helden-Seite unter „Waffen“ wechselst du mit einem Tipp auf das Bild die Waffe."
msgstr ""

#: src/data_fuehrung.gd:152
msgid "Seltenheit und Stufe"
msgstr ""

#: src/data_fuehrung.gd:152
msgid "Gewöhnlich, Selten, Episch, Legendär: höhere Seltenheit bringt mehr Schaden und Zusatzwerte. In der Werkstatt verbesserst und verschmilzt du Stücke (drei gleiche → eines der nächsten Seltenheit)."
msgstr ""

#: src/data_fuehrung.gd:153 src/hud.gd:329 src/hud_guide.gd:15 src/screens.gd:45
msgid "Begleiter"
msgstr ""

#: src/data_fuehrung.gd:154
msgid "Was sie tun"
msgstr ""

#: src/data_fuehrung.gd:154
msgid "Ein Begleiter folgt deinem Helden auf Expeditionen, trägt Beute und hilft je nach Art beim Kämpfen, Heilen oder Sammeln."
msgstr ""

#: src/data_fuehrung.gd:155
msgid "Bekommen"
msgstr ""

#: src/data_fuehrung.gd:155
msgid "Manche Begleiter sitzen gefangen auf Expeditionen (Phase „Erkunden“) – befreie sie. Andere baust du aus Rohstoffen oder kaufst sie im Bildschirm „Begleiter“."
msgstr ""

#: src/data_fuehrung.gd:156
msgid "Stufen"
msgstr ""

#: src/data_fuehrung.gd:156
msgid "Begleiter sammeln Erfahrung mit jeder Ladung und jedem Kampf. Höhere Stufen tragen mehr und kämpfen besser."
msgstr ""

#: src/data_fuehrung.gd:157
msgid "Wartezeiten"
msgstr ""

#: src/data_fuehrung.gd:158
msgid "Bauzeiten"
msgstr ""

#: src/data_fuehrung.gd:158
msgid "Jeder Bau braucht eine Baudrohne und Zeit. Die ersten Bauten dauern unter einer Minute, späte Stufen Stunden."
msgstr ""

#: src/data_fuehrung.gd:159
msgid "Gratis fertig"
msgstr ""

#: src/data_fuehrung.gd:159
msgid "Liegt die Restzeit unter einer Minute, stellst du den Bau gratis fertig. Sonst kostet das Juwelen – je länger, desto mehr."
msgstr ""

#: src/data_fuehrung.gd:160
msgid "Bau-Warteschlange"
msgstr ""

#: src/data_fuehrung.gd:160
msgid "Sind alle Drohnen beschäftigt, kannst du den nächsten Auftrag vormerken. Er startet von selbst, sobald eine Drohne frei ist und die Rohstoffe reichen."
msgstr ""

#: src/data_fuehrung.gd:161
msgid "Expedition spart Zeit"
msgstr ""

#: src/data_fuehrung.gd:161
msgid "Jede Expedition zieht 15 Minuten von laufenden Bauten ab."
msgstr ""

#: src/data_fuehrung.gd:162
msgid "Juwelen gehören deinem Konto und gelten in allen deinen Städten."
msgstr ""

#: src/data_fuehrung.gd:163
msgid "Die Flut"
msgstr ""

#: src/data_fuehrung.gd:164
msgid "Jeden siebten Tag"
msgstr ""

#: src/data_fuehrung.gd:164
msgid "Am siebten Tag der Woche kommt die Flut aus zwei Richtungen. Startest du sie nicht, verteidigt sich die Basis allein (Berechnung)."
msgstr ""

#: src/data_fuehrung.gd:165 src/hud.gd:1198 src/screens/quests.gd:93
msgid "Wellen"
msgstr ""

#: src/data_fuehrung.gd:165
msgid "Die Flut kommt in Wellen. Zwischen den Wellen zeigt eine Vorschau, welche Gegnerarten als Nächstes kommen."
msgstr ""

#: src/data_fuehrung.gd:166
msgid "Schwierigkeit"
msgstr ""

#: src/data_fuehrung.gd:166
msgid "Vor dem Start wählst du Normal, Schwer oder Albtraum. Schwerer heißt: mehr und zähere Gegner, aber deutlich mehr Beute."
msgstr ""

#: src/data_fuehrung.gd:167
msgid "Verlieren"
msgstr ""

#: src/data_fuehrung.gd:167
msgid "Fällt der Bunker, gehen bis zu 20 % der gelagerten Rohstoffe verloren. Gebäude bleiben stehen, beschädigte reparieren die Handwerker."
msgstr ""

#: src/data_fuehrung.gd:168 src/screens/rueckblick.gd:151
msgid "Übung"
msgstr ""

#: src/data_fuehrung.gd:168
msgid "Der Übungsalarm (einmal am Tag) ist schwächer und kostet nichts."
msgstr ""

#: src/data_fuehrung.gd:169
msgid "Turmziele"
msgstr ""

#: src/data_fuehrung.gd:169
msgid "Tippe einen Turm an und wähle sein Ziel: nächster, stärkster, fliegend oder Boss."
msgstr ""

#: src/data_fuehrung.gd:171
msgid "Ablauf"
msgstr ""

#: src/data_fuehrung.gd:171
msgid "Ankommen → Aufbauen → Großangriff überstehen → Erkunden. Wer alle Pflichtplätze baut und den Großangriff übersteht, bekommt eine Außenbasis mit dauerhaftem Vorteil."
msgstr ""

#: src/data_fuehrung.gd:172
msgid "Rucksack"
msgstr ""

#: src/data_fuehrung.gd:172
msgid "Stell dich neben Bäume, Felsen oder Schrott, dann sammelt dein Held. Der Rucksack hat ein Gewicht; bring Ladungen ins Depot."
msgstr ""

#: src/data_fuehrung.gd:173 src/hud.gd:1405
msgid "Heimkehren"
msgstr ""

#: src/data_fuehrung.gd:173
msgid "An der Zentrale oder am Fahrzeug erscheint „Heimkehren“. Fällt dein Held, kommen Depot und halber Rucksack heim."
msgstr ""

#: src/data_fuehrung.gd:174
msgid "Gebiete"
msgstr ""

#: src/data_fuehrung.gd:174
msgid "Jedes Gebiet hat seine eigene Gegnerfamilie. Je weiter, desto stärker die Gegner – und desto wertvoller die Beute."
msgstr ""

#: src/data_fuehrung.gd:175
msgid "Forschung und Belagerung"
msgstr ""

#: src/data_fuehrung.gd:176
msgid "Drei Äste mit je elf Knoten: Türme und Mauern, Wirtschaft, Helden und Expedition. Jeder Knoten kostet Rohstoffe (ab der zweiten Reihe auch Sternsplitter) und Zeit; es läuft immer eine Forschung. Die Wirkung gilt sofort und dauerhaft."
msgstr ""

#: src/data_fuehrung.gd:177
msgid "Tüftelecke und Labor"
msgstr ""

#: src/data_fuehrung.gd:177
msgid "Die erste Reihe jedes Astes erforschst du schon in der Werkstatt. Das Labor (ab Bunker 8) öffnet den Rest; höhere Laborstufen öffnen tiefere Reihen und forschen schneller."
msgstr ""

#: src/data_fuehrung.gd:178
msgid "Regen macht Türme langsamer und Feuer schwächer, Nebel kürzt die Reichweite, nachts sind die Gegner zäher – dafür gibt es mehr Beute. Die Vorschau zeigt das Wetter vor dem Start."
msgstr ""

#: src/data_fuehrung.gd:179
msgid "Kluge Belagerer"
msgstr ""

#: src/data_fuehrung.gd:179
msgid "Brocken suchen gemeinsam die schwächste Stelle der Mauer, Flieger fliegen um die Luftabwehr herum, und ab Woche 3 tragen einzelne Schleimlinge Leitern und klettern über die Mauer."
msgstr ""

#: src/data_fuehrung.gd:180
msgid "Rückblick und Reparatur"
msgstr ""

#: src/data_fuehrung.gd:180
msgid "Nach jeder Flut zeigt der Rückblick, wo die Mauer brach und welche Türme am meisten geleistet haben. Mauern behalten ihren Schaden – „Alle reparieren“ macht sie wieder heil."
msgstr ""

#: src/data_fuehrung.gd:181
msgid "Aufbauten teilen und testen"
msgstr ""

#: src/data_fuehrung.gd:181
msgid "Im Bunker unter „Aufbauten“ kopierst du einen Aufbau als Code, fügst fremde Codes ein und schickst die Flut der Woche gegen einen gespeicherten Aufbau – ohne Verlust."
msgstr ""

#: src/data_fuehrung.gd:182
msgid "Verletzte Bewohner"
msgstr ""

#: src/data_fuehrung.gd:182
msgid "Nach einer verlorenen oder harten Flut tragen einige Bewohner einen Verband und gehen langsamer. Sie heilen mit der Zeit und lassen sich im Bunker verarzten; das Feldlazarett halbiert die Heilzeit."
msgstr ""

#: src/data_fuehrung.gd:183
msgid "Bedienung"
msgstr ""

#: src/data_geschichte.gd:10
msgid "Rosa Kramer"
msgstr ""

#: src/data_geschichte.gd:10
msgid "Die Händlerin"
msgstr ""

#: src/data_geschichte.gd:11
msgid "Gegnerlager"
msgstr ""

#: src/data_geschichte.gd:11
msgid "Feilscht am Tauschladen"
msgstr ""

#: src/data_geschichte.gd:12
msgid "Baut den Tauschladen: jeden Tag neue Tauschangebote, einmal in der Woche ein Begleiter-Ei."
msgstr ""

#: src/data_geschichte.gd:13
msgid "Rosa fuhr mit der Karawane durch die Staubebene und verkaufte alles – Werkzeuge, Ersatzteile, sogar Eier, aus denen seltsame Tiere schlüpfen. Dann haben die Waschbär-Diebe ihren Karren überfallen. Mitsamt Rosa."
msgstr ""

#: src/data_geschichte.gd:14
msgid "Breiter Sonnenhut mit Blume, orange Bluse, türkises Halstuch und eine riesige Kraxe voller Töpfe."
msgstr ""

#: src/data_geschichte.gd:15
msgid "Professor Theo Moosbach"
msgstr ""

#: src/data_geschichte.gd:15
msgid "Der Forscher"
msgstr ""

#: src/data_geschichte.gd:16
msgid "Schleimfalle"
msgstr ""

#: src/data_geschichte.gd:16
msgid "Forscht und macht Notizen"
msgstr ""

#: src/data_geschichte.gd:17
msgid "Hilft im Labor: Forschung geht 25 % schneller."
msgstr ""

#: src/data_geschichte.gd:18
msgid "Theo Moosbach war Adas Lehrer an der Uni. Er wollte den Schleim im Sumpfwerk erforschen. Der Schleim hat zurückgeforscht und ihn in einen Kokon gewickelt. Er hat trotzdem weiter Notizen gemacht."
msgstr ""

#: src/data_geschichte.gd:19
msgid "Tropenhelm, runde Brille, weißer Bart, Tweedjacke mit Fliege und eine Ledertasche voller Notizbücher."
msgstr ""

#: src/data_geschichte.gd:20
msgid "Knut Amboss"
msgstr ""

#: src/data_geschichte.gd:20
msgid "Der Schmied"
msgstr ""

#: src/data_geschichte.gd:21
msgid "Käfig aus Eis"
msgstr ""

#: src/data_geschichte.gd:21
msgid "Hämmert an einer Klinge"
msgstr ""

#: src/data_geschichte.gd:22
msgid "Arbeitet in der Werkstatt: Waffen verbessern kostet 20 % weniger."
msgstr ""

#: src/data_geschichte.gd:23
msgid "Knut hat einen Deckel aus Stahl geschmiedet, so groß wie ein Scheunentor, um den Krater einfach zuzumachen. Er kam bis zum Frostpass. Dort haben ihn die Eiswesen eingefroren – mitsamt Deckel."
msgstr ""

#: src/data_geschichte.gd:24
msgid "Roter Bart, rotes Kopftuch, Lederschürze und ein Schmiedehammer auf dem Rücken."
msgstr ""

#: src/data_geschichte.gd:87
msgid "Grüne Bäche"
msgstr ""

#: src/data_geschichte.gd:90
msgid "Kapitel 1: Grüntal"
msgstr ""

#: src/data_geschichte.gd:90
msgid "Hier fing alles an – mit elf Tagen Regen."
msgstr ""

#: src/data_geschichte.gd:91
msgid "Der Bach ist grün und schmatzt über die Steine."
msgstr ""

#: src/data_geschichte.gd:91
msgid "Frieda von der Mühle sagt: Erst kam der Regen, dann kamen die Kleckse."
msgstr ""

#: src/data_geschichte.gd:92
msgid "Überall Schleimspuren – und alle laufen bergauf."
msgstr ""

#: src/data_geschichte.gd:92
msgid "Nach Süden, zum Rand des Tals. Dorthin, wo der Krater liegt."
msgstr ""

#: src/data_geschichte.gd:93
msgid "Wer die Flut aufhalten will, muss wissen, woher sie kommt."
msgstr ""

#: src/data_geschichte.gd:93
msgid "Also los: das Grüntal sichern, dann der Spur folgen."
msgstr ""

#: src/data_geschichte.gd:94
msgid "Die Krone"
msgstr ""

#: src/data_geschichte.gd:97
msgid "Dicker Bert ist geplatzt!"
msgstr ""

#: src/data_geschichte.gd:97
msgid "Zurück bleiben eine Pfütze, ein beleidigter Blick – und seine Krone."
msgstr ""

#: src/data_geschichte.gd:98
msgid "In der Krone steckt ein Stein, der von innen leuchtet."
msgstr ""

#: src/data_geschichte.gd:98
msgid "Ein Sternsplitter. Er wird warm, wenn man ihn nach Süden hält."
msgstr ""

#: src/data_geschichte.gd:99
msgid "Ein Stein, der den Weg zeigt."
msgstr ""

#: src/data_geschichte.gd:99
msgid "Wie ein Brief mit Adresse, sagt Jona. Absender: der Krater."
msgstr ""

#: src/data_geschichte.gd:100
msgid "Die Spur führt in den Kiefernforst."
msgstr ""

#: src/data_geschichte.gd:100
msgid "Dort wachsen seit dem Regen die Bäume über die Straßen."
msgstr ""

#: src/data_geschichte.gd:101
msgid "Nebel im Forst"
msgstr ""

#: src/data_geschichte.gd:104
msgid "Kapitel 2: Kiefernforst"
msgstr ""

#: src/data_geschichte.gd:104
msgid "Der Wald ist dichter als vor dem Regen. Viel dichter."
msgstr ""

#: src/data_geschichte.gd:105
msgid "Irrlichter tanzen über den Wegen."
msgstr ""

#: src/data_geschichte.gd:105
msgid "Wer rennt, hat bald den ganzen Wald am Hals. Wer leise geht, kommt durch."
msgstr ""

#: src/data_geschichte.gd:106
msgid "Riesige Kettenspuren im Schlamm."
msgstr ""

#: src/data_geschichte.gd:106
msgid "Hier ist ein Bagger durchgefahren. Ein gelber. Mit Namen."
msgstr ""

#: src/data_geschichte.gd:107
msgid "Tief im Forst sitzt die Mooskönigin."
msgstr ""

#: src/data_geschichte.gd:107
msgid "Sie lässt den Wald wuchern – und der Wald riecht nach Krater."
msgstr ""

#: src/data_geschichte.gd:108
msgid "Das Moos weicht"
msgstr ""

#: src/data_geschichte.gd:111
msgid "Die Mooskönigin sinkt in sich zusammen."
msgstr ""

#: src/data_geschichte.gd:111
msgid "Aus ihrem Pilzhut rieseln Sternsplitter wie Sporen."
msgstr ""

#: src/data_geschichte.gd:112
msgid "Der Nebel hebt sich."
msgstr ""

#: src/data_geschichte.gd:112
msgid "Zum ersten Mal seit Monaten fällt Sonne auf den alten Waldweg."
msgstr ""

#: src/data_geschichte.gd:113
msgid "An der Riesenkiefer hängt die Karte des Försters."
msgstr ""

#: src/data_geschichte.gd:113
msgid "Alle grünen Linien darauf laufen an einem Punkt zusammen: dem Krater."
msgstr ""

#: src/data_geschichte.gd:114
msgid "Hinter dem Wald beginnt die Staubebene."
msgstr ""

#: src/data_geschichte.gd:114
msgid "Dort, sagt man, hatte eine Erfinderin ihr Labor."
msgstr ""

#: src/data_geschichte.gd:115
msgid "Staub und Schrott"
msgstr ""

#: src/data_geschichte.gd:118
msgid "Kapitel 3: Staubebene"
msgstr ""

#: src/data_geschichte.gd:118
msgid "Eine Tankstelle, ein Wasserturm und sehr, sehr viel Sand."
msgstr ""

#: src/data_geschichte.gd:119
msgid "Die Karawane kommt nicht mehr."
msgstr ""

#: src/data_geschichte.gd:119
msgid "Waschbär-Diebe haben sie überfallen – und die Händlerin Rosa Kramer gleich mit."
msgstr ""

#: src/data_geschichte.gd:120
msgid "Zwischen den Autowracks stapft etwas Großes."
msgstr ""

#: src/data_geschichte.gd:120
msgid "Der Rostbrocken: ein Golem aus Schrott, mit einem Kessel im Bauch."
msgstr ""

#: src/data_geschichte.gd:121
msgid "Und der Kessel … regnet."
msgstr ""

#: src/data_geschichte.gd:121
msgid "Mitten in der Wüste fällt aus seinem Bauch ein kleiner, grüner Schauer."
msgstr ""

#: src/data_geschichte.gd:122
msgid "Der Wetterkessel"
msgstr ""

#: src/data_geschichte.gd:125
msgid "Der Rostbrocken fällt auseinander."
msgstr ""

#: src/data_geschichte.gd:125
msgid "Schrauben, Radkappen, ein Kühlschrank – und der Kessel."
msgstr ""

#: src/data_geschichte.gd:126
msgid "Auf dem Kessel steht: Dr. A. Volt – Wettermaschine Nr. 1."
msgstr ""

#: src/data_geschichte.gd:126
msgid "Das Herz der Maschine, die den großen Regen gemacht hat."
msgstr ""

#: src/data_geschichte.gd:127
msgid "Der Regen hat etwas tief unter dem Krater geweckt."
msgstr ""

#: src/data_geschichte.gd:127
msgid "Und der Kessel hat es seitdem gefüttert. Tropfen für Tropfen."
msgstr ""

#: src/data_geschichte.gd:128
msgid "Einen Aus-Knopf hat der Kessel nicht."
msgstr ""

#: src/data_geschichte.gd:128
msgid "Also bekommt er eine Delle. Er hustet, tröpfelt – und hört auf zu regnen."
msgstr ""

#: src/data_geschichte.gd:129
msgid "Doch der Schleim ist längst unterwegs – bis ans Meer."
msgstr ""

#: src/data_geschichte.gd:129
msgid "Nächster Halt: die Schrottküste."
msgstr ""

#: src/data_geschichte.gd:130 src/data_welt.gd:121
msgid "Das Leuchtfeuer"
msgstr ""

#: src/data_geschichte.gd:133
msgid "Kapitel 4: Schrottküste"
msgstr ""

#: src/data_geschichte.gd:133
msgid "Zweiundvierzig Wracks, ein Leuchtturm und Möwen, die verdächtig still sind."
msgstr ""

#: src/data_geschichte.gd:134
msgid "Eine Schleimspur führt vom Land ins Meer."
msgstr ""

#: src/data_geschichte.gd:134
msgid "Breit wie eine Straße. Etwas Großes ist hier hineingekrochen."
msgstr ""

#: src/data_geschichte.gd:135
msgid "Nachts stehen Matrosen am Strand und starren aufs Wasser."
msgstr ""

#: src/data_geschichte.gd:135
msgid "Die Mannschaft der Möwe. Ihr Kapitän heißt jetzt Glibber."
msgstr ""

#: src/data_geschichte.gd:136
msgid "Im Leuchtturm sollen noch Leute sein."
msgstr ""

#: src/data_geschichte.gd:136
msgid "Und ganz oben: jemand mit einer halben Flasche Luft."
msgstr ""

#: src/data_geschichte.gd:137
msgid "Glibber geht von Bord"
msgstr ""

#: src/data_geschichte.gd:140
msgid "Kapitän Glibber zerfließt zu einer Pfütze mit Hut."
msgstr ""

#: src/data_geschichte.gd:140
msgid "Seine Mannschaft nimmt die Mützen ab – und wird wieder zu Seeleuten."
msgstr ""

#: src/data_geschichte.gd:141
msgid "Der Steuermann zeigt aufs Meer."
msgstr ""

#: src/data_geschichte.gd:141
msgid "„Da unten liegt eine leere Haut, groß wie ein Bus. Was sie abgestreift hat, ist größer.“"
msgstr ""

#: src/data_geschichte.gd:142
msgid "Etwas wächst im Meer."
msgstr ""

#: src/data_geschichte.gd:142
msgid "Aber der Schleim im Meer kam vom Land. Die Quelle liegt im Krater."
msgstr ""

#: src/data_geschichte.gd:143
msgid "Im Hinterland raucht ein Schlot."
msgstr ""

#: src/data_geschichte.gd:143
msgid "Das alte Sumpfwerk pumpt wieder. Nur weiß keiner, was."
msgstr ""

#: src/data_geschichte.gd:144
msgid "Das Werk pumpt"
msgstr ""

#: src/data_geschichte.gd:147
msgid "Kapitel 5: Sumpfwerk"
msgstr ""

#: src/data_geschichte.gd:147
msgid "Eine Fabrik im Sumpf, voller Rohre, voller Tümpel, voller grünem Zeug."
msgstr ""

#: src/data_geschichte.gd:148
msgid "Der Schlot raucht, obwohl niemand heizt."
msgstr ""

#: src/data_geschichte.gd:148
msgid "Und in den Rohren klopft es. Von innen."
msgstr ""

#: src/data_geschichte.gd:149
msgid "Im Kesselhaus liegt ein Notizbuch von Ada."
msgstr ""

#: src/data_geschichte.gd:149
msgid "Daneben ein Kokon aus Schleim, mit einem Tropenhelm obendrauf."
msgstr ""

#: src/data_geschichte.gd:150
msgid "Das ist Professor Theo Moosbach!"
msgstr ""

#: src/data_geschichte.gd:150
msgid "Er wollte den Schleim erforschen. Der Schleim hat zurückgeforscht."
msgstr ""

#: src/data_geschichte.gd:151
msgid "Der Schlund schweigt"
msgstr ""

#: src/data_geschichte.gd:154
msgid "Der Schlund verschluckt sich an seinem letzten Bissen."
msgstr ""

#: src/data_geschichte.gd:154
msgid "Die Pumpen stottern – und stehen still."
msgstr ""

#: src/data_geschichte.gd:155
msgid "Die Rohre führten alle an einen Ort."
msgstr ""

#: src/data_geschichte.gd:155
msgid "Zum Krater. Das Werk hat Wasser hineingepumpt, Woche für Woche."
msgstr ""

#: src/data_geschichte.gd:156
msgid "Was immer im Krater wohnt: Es liebt Wasser."
msgstr ""

#: src/data_geschichte.gd:156
msgid "Und es wird größer, je mehr es bekommt."
msgstr ""

#: src/data_geschichte.gd:157
msgid "Der Weg zum Krater führt über den Frostpass."
msgstr ""

#: src/data_geschichte.gd:157
msgid "Dort oben, erzählen die Vögel, wartet etwas."
msgstr ""

#: src/data_geschichte.gd:158
msgid "Die Vögel warten"
msgstr ""

#: src/data_geschichte.gd:161
msgid "Kapitel 6: Frostpass"
msgstr ""

#: src/data_geschichte.gd:161
msgid "Mitten im Sommer ist der Wasserfall zu Eis erstarrt."
msgstr ""

#: src/data_geschichte.gd:162
msgid "Tausende Zugvögel sitzen auf den Felsen."
msgstr ""

#: src/data_geschichte.gd:162
msgid "Alle schauen nach Süden. Keiner fliegt."
msgstr ""

#: src/data_geschichte.gd:163
msgid "Unter dem Eisbogen leuchtet etwas blau."
msgstr ""

#: src/data_geschichte.gd:163
msgid "Kalt und hell – wie ein Stern, der hier heruntergefallen ist."
msgstr ""

#: src/data_geschichte.gd:164
msgid "Ein Schmied steckt im Eis fest."
msgstr ""

#: src/data_geschichte.gd:164
msgid "Knut Amboss wollte den Krater mit einem Stahldeckel zumachen. Er kam nur bis hier."
msgstr ""

#: src/data_geschichte.gd:165
msgid "Der Pass ist frei"
msgstr ""

#: src/data_geschichte.gd:168
msgid "Der Frostbrocken zerspringt in tausend Eiswürfel."
msgstr ""

#: src/data_geschichte.gd:168
msgid "Die Eiswesen ziehen sich zurück – nach Süden, als würden sie gerufen."
msgstr ""

#: src/data_geschichte.gd:169
msgid "Unter dem Eis liegt ein Sternsplitter, groß wie ein Haus."
msgstr ""

#: src/data_geschichte.gd:169
msgid "Er ist vom Himmel gefallen. Vor langer Zeit. Zusammen mit dem Krater."
msgstr ""

#: src/data_geschichte.gd:170
msgid "Der Krater ist kein Loch im Boden."
msgstr ""

#: src/data_geschichte.gd:170
msgid "Er ist der Abdruck eines Sterns – und der Stern liegt noch drin."
msgstr ""

#: src/data_geschichte.gd:171
msgid "Die Vögel heben die Köpfe."
msgstr ""

#: src/data_geschichte.gd:171
msgid "Der Weg in den Schleimkrater ist offen."
msgstr ""

#: src/data_geschichte.gd:172
msgid "Das Sternherz"
msgstr ""

#: src/data_geschichte.gd:175
msgid "Kapitel 7: Schleimkrater"
msgstr ""

#: src/data_geschichte.gd:175
msgid "Alles leuchtet grün. Der Boden summt. Die Luft schmeckt nach Brause."
msgstr ""

#: src/data_geschichte.gd:176
msgid "In der Mitte steht ein Ring aus Stein."
msgstr ""

#: src/data_geschichte.gd:176
msgid "Darin pulsiert etwas wie ein Herz. Einmal in der Woche schlägt es ganz laut."
msgstr ""

#: src/data_geschichte.gd:177
msgid "Das Sternherz."
msgstr ""

#: src/data_geschichte.gd:177
msgid "Vor langer Zeit fiel es vom Himmel und schlief tief unter dem Tal. Bis der Regen kam."
msgstr ""

#: src/data_geschichte.gd:178
msgid "Doch es schlägt nicht von allein."
msgstr ""

#: src/data_geschichte.gd:178
msgid "Vor dem Ring thront der Schleimkönig – und drückt jede Woche zu."
msgstr ""

#: src/data_geschichte.gd:179
msgid "Jeder Herzschlag ist eine Flut."
msgstr ""

#: src/data_geschichte.gd:179
msgid "Wer das Tal retten will, muss den König vom Thron holen."
msgstr ""

#: src/data_geschichte.gd:180
msgid "Der König fällt"
msgstr ""

#: src/data_geschichte.gd:183
msgid "Die Schleimhülle des Königs platzt."
msgstr ""

#: src/data_geschichte.gd:183
msgid "Darunter: Hörner, Glut und ein sehr überraschter Dämon."
msgstr ""

#: src/data_geschichte.gd:184
msgid "Er flieht in den Ring – und der Ring färbt sich rot."
msgstr ""

#: src/data_geschichte.gd:184
msgid "Ein Feuerstrahl schießt über das Meer, bis zu einer Insel am Horizont."
msgstr ""

#: src/data_geschichte.gd:185
msgid "Das Sternherz ist weg!"
msgstr ""

#: src/data_geschichte.gd:185
msgid "Der Dämon hat es mitgerissen. Der König war nur ein Statthalter."
msgstr ""

#: src/data_geschichte.gd:186
msgid "Der Krater wird still."
msgstr ""

#: src/data_geschichte.gd:186
msgid "Ein paar Zugvögel wagen sich in die Luft. Das Grün wird ein bisschen blasser."
msgstr ""

#: src/data_geschichte.gd:187
msgid "Ein Funke im Süden"
msgstr ""

#: src/data_geschichte.gd:191 src/data_geschichte.gd:245
msgid "Ende von Akt 1"
msgstr ""

#: src/data_geschichte.gd:191
msgid "Das Tal atmet auf. Die Fluten werden kleiner – aber sie hören nicht auf."
msgstr ""

#: src/data_geschichte.gd:192
msgid "In der Basis wird gefeiert."
msgstr ""

#: src/data_geschichte.gd:192
msgid "Am Tor läutet eine Glocke, und die Bewohner tanzen ums Lagerfeuer."
msgstr ""

#: src/data_geschichte.gd:193
msgid "Doch am Horizont raucht die Vulkaninsel."
msgstr ""

#: src/data_geschichte.gd:193
msgid "Dort schürt jemand ein Feuer – mit einem gestohlenen Herzen."
msgstr ""

#: src/data_geschichte.gd:194
msgid "Magmafürst Brodel."
msgstr ""

#: src/data_geschichte.gd:194
msgid "Der Herr des Schleimkönigs. Und er hat gerade erst angefangen."
msgstr ""

#: src/data_geschichte.gd:195
msgid "Weiter in Akt 2: Vulkaninsel"
msgstr ""

#: src/data_geschichte.gd:195
msgid "Obsidian, wandernde Lava und ein sehr heißer Fürst warten."
msgstr ""

#: src/data_geschichte.gd:197
msgid "Die Insel brennt"
msgstr ""

#: src/data_geschichte.gd:200
msgid "Akt 2 · Kapitel 8: Vulkaninsel"
msgstr ""

#: src/data_geschichte.gd:200
msgid "Schwarze Felder, wandernde Lava und eine Hitze, die die Stiefel weich macht."
msgstr ""

#: src/data_geschichte.gd:201
msgid "Seit das Herz hier ist, raucht der Vulkan."
msgstr ""

#: src/data_geschichte.gd:201
msgid "Magmafürst Brodel schürt sein Feuer damit – Tag und Nacht."
msgstr ""

#: src/data_geschichte.gd:202
msgid "Bricht der Vulkan aus, regnet Asche auf das ganze Tal."
msgstr ""

#: src/data_geschichte.gd:202
msgid "Dann gibt es kein Talfest mehr. Nie wieder."
msgstr ""

#: src/data_geschichte.gd:203
msgid "Obsidian ist härter als jeder Stein."
msgstr ""

#: src/data_geschichte.gd:203
msgid "Knut sagt, damit hält man sogar Lava auf. Hoffentlich hat er recht."
msgstr ""

#: src/data_geschichte.gd:204
msgid "Das Herz kehrt heim"
msgstr ""

#: src/data_geschichte.gd:207
msgid "Magmafürst Brodel stolpert in seine eigene Lava."
msgstr ""

#: src/data_geschichte.gd:207
msgid "Zischend geht seine Krone aus."
msgstr ""

#: src/data_geschichte.gd:208
msgid "Aus der Glut steigt ein kleines Licht."
msgstr ""

#: src/data_geschichte.gd:208
msgid "Das Sternherz. Kleiner als gedacht – und ziemlich müde."
msgstr ""

#: src/data_geschichte.gd:209
msgid "Es fliegt nicht davon."
msgstr ""

#: src/data_geschichte.gd:209
msgid "Es kreist einmal um den Trupp und zieht dann heim ins Tal, in den stillen Krater."
msgstr ""

#: src/data_geschichte.gd:210
msgid "Ein Herz, das schlafen will."
msgstr ""

#: src/data_geschichte.gd:210
msgid "Ohne König, ohne Fürst. Nur noch ein leises Leuchten unter dem Tal."
msgstr ""

#: src/data_geschichte.gd:216 src/data_geschichte.gd:246
msgid "Ende von Akt 2"
msgstr ""

#: src/data_geschichte.gd:216
msgid "Der Vulkan schläft. Der Krater schläft. Und das Tal feiert."
msgstr ""

#: src/data_geschichte.gd:217
msgid "Das Talfest!"
msgstr ""

#: src/data_geschichte.gd:217
msgid "Ein Kuchen so groß wie ein Scheunentor und ein Feuerwerk bis zum Frostpass."
msgstr ""

#: src/data_geschichte.gd:218
msgid "Am Waldrand sitzen drei kleine Schleimlinge und schauen zu."
msgstr ""

#: src/data_geschichte.gd:218
msgid "Sie bekommen auch ein Stück. Sie benehmen sich. Meistens."
msgstr ""

#: src/data_geschichte.gd:219
msgid "Doch tief im Meer bewegt sich etwas."
msgstr ""

#: src/data_geschichte.gd:219
msgid "Die Haut, so groß wie ein Bus, war nur der Anfang."
msgstr ""

#: src/data_geschichte.gd:220
msgid "Die Wellen werden kleiner – aber sie kommen noch."
msgstr ""

#: src/data_geschichte.gd:220
msgid "Halte die Mauern stark. Die Geschichte geht weiter."
msgstr ""

#: src/data_geschichte.gd:222
msgid "Lichter in der Stadt"
msgstr ""

#: src/data_geschichte.gd:226
msgid "Akt 3 · Kapitel 9: Stadtruinen"
msgstr ""

#: src/data_geschichte.gd:226
msgid "Nach dem Talfest knackt das Funkgerät: „Die Stadtverwaltung bittet um Ruhe.“"
msgstr ""

#: src/data_geschichte.gd:227
msgid "Im Norden gehen die Lichter an."
msgstr ""

#: src/data_geschichte.gd:227
msgid "Zum ersten Mal seit Jahren – Ampeln schalten, Rasenmäher mähen Asphalt."
msgstr ""

#: src/data_geschichte.gd:228
msgid "Sternsplitter im Schleim sind bis ins alte Kraftwerk geflossen."
msgstr ""

#: src/data_geschichte.gd:228
msgid "Seitdem hat die Stadt Strom – und ihre Maschinen einen eigenen Kopf."
msgstr ""

#: src/data_geschichte.gd:229
msgid "Bürgermeister Bolzen."
msgstr ""

#: src/data_geschichte.gd:229
msgid "Ein Straßenbahnwagen mit Zylinder. Er sammelt Splitter, damit die Lichter nie ausgehen."
msgstr ""

#: src/data_geschichte.gd:230
msgid "Auf die Dächer, in die Schächte!"
msgstr ""

#: src/data_geschichte.gd:230
msgid "Oben kommt kein Mäher hin. Und unten fährt die U-Bahn – wenn jemand Strom macht."
msgstr ""

#: src/data_geschichte.gd:231
msgid "Feierabend"
msgstr ""

#: src/data_geschichte.gd:235
msgid "Bürgermeister Bolzen setzt sich hin."
msgstr ""

#: src/data_geschichte.gd:235
msgid "Aus seinem Akku kullert ein Sternsplitter. Der Zylinder rollt hinterher."
msgstr ""

#: src/data_geschichte.gd:236
msgid "Aus allen Lautsprechern knackt es ein letztes Mal:"
msgstr ""

#: src/data_geschichte.gd:236
msgid "„Die Stadtverwaltung wünscht einen schönen Feierabend.“"
msgstr ""

#: src/data_geschichte.gd:237
msgid "Die Maschinen bleiben stehen. Die Lichter bleiben an."
msgstr ""

#: src/data_geschichte.gd:237
msgid "Jetzt leuchten sie für alle, die hier wieder wohnen wollen."
msgstr ""

#: src/data_geschichte.gd:238
msgid "Doch unter der Stadt führen die Schächte tiefer als jede Karte."
msgstr ""

#: src/data_geschichte.gd:238
msgid "Dort unten leuchtet etwas Blaues. Riecht nach Pilzen. Die Geschichte geht weiter."
msgstr ""

