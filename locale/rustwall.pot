msgstr ""

#: src/data_fuehrung.gd:93
msgid "Unter einer Minute Restzeit stellst du jeden Bau gratis fertig."
msgstr ""

#: src/data_fuehrung.gd:94
msgid "Mauern lenken die Schleimlinge: Ziehe mit dem Finger über mehrere Felder, um eine ganze Reihe zu setzen."
msgstr ""

#: src/data_fuehrung.gd:95
msgid "Tore öffnen sich für dich, deine Fahrzeuge und Bewohner – Gegner müssen sie einreißen."
msgstr ""

#: src/data_fuehrung.gd:96
msgid "Ist eine Drohne beschäftigt, kannst du den nächsten Bau vormerken. Er startet von selbst."
msgstr ""

#: src/data_fuehrung.gd:97
msgid "Jede Gegnerfamilie hat Schwächen. Waldgeister brennen gut, Eiswesen auch."
msgstr ""

#: src/data_fuehrung.gd:98
msgid "Ein Turm lässt sich auf ein Ziel einstellen: nächster, stärkster, fliegend oder Boss."
msgstr ""

#: src/data_fuehrung.gd:99
msgid "Im Rucksack zählt das Gewicht. Stein und Metall sind schwer, Münzen leicht."
msgstr ""

#: src/data_fuehrung.gd:100
msgid "Das Depot der Außenbasis bringt seine Ladung sicher heim – auch wenn dein Held fällt."
msgstr ""

#: src/data_fuehrung.gd:101
msgid "Der Übungsalarm kostet nichts und zeigt dir, wo deine Mauer schwach ist."
msgstr ""

#: src/data_fuehrung.gd:102
msgid "Begleiter tragen Beute und helfen im Kampf. Jeder kann etwas anderes."
msgstr ""

#: src/data_fuehrung.gd:103
msgid "Eine schwerere Flut bringt mehr Beute – wähle sie, wenn deine Türme stark sind."
msgstr ""

#: src/data_fuehrung.gd:104
msgid "Die Ziele-Leiste links zeigt dir immer, was als Nächstes sinnvoll ist."
msgstr ""

#: src/data_fuehrung.gd:105
msgid "Fällt der Bunker, gehen bis zu 20 % der gelagerten Rohstoffe verloren – Gebäude bleiben stehen."
msgstr ""

#: src/data_fuehrung.gd:106
msgid "Helden lernen Waffen mit ihrer Stufe. Die Helden-Seite zeigt alle 15 Waffen und wo es sie gibt."
msgstr ""

#: src/data_fuehrung.gd:107
msgid "Nach der Flut reparieren die Handwerker beschädigte Gebäude nach und nach."
msgstr ""

#: src/data_fuehrung.gd:108
msgid "Unter „Hilfe“ findest du alles über Elemente, Waffenarten, Begleiter und Wartezeiten."
msgstr ""

#: src/data_fuehrung.gd:114
msgid "Die Flut, wie sie kommt."
msgstr ""

#: src/data_fuehrung.gd:115
msgid "+30 % Gegner, +25 % Leben · +50 % Beute"
msgstr ""

#: src/data_fuehrung.gd:116
msgid "+60 % Gegner, +60 % Leben · doppelte Beute"
msgstr ""

#: src/data_fuehrung.gd:121 src/data_fuehrung.gd:131
msgid "Automatisch"
msgstr ""

#: src/data_fuehrung.gd:121
msgid "Nächster"
msgstr ""

#: src/data_fuehrung.gd:121
msgid "Stärkster"
msgstr ""

#: src/data_fuehrung.gd:122
msgid "Fliegend"
msgstr ""

#: src/data_fuehrung.gd:131
msgid "Groß"
msgstr ""

#: src/data_fuehrung.gd:131
msgid "Sehr groß"
msgstr ""

#: src/data_fuehrung.gd:139
msgid "Erste Schritte"
msgstr ""

#: src/data_fuehrung.gd:140
msgid "Worum geht es?"
msgstr ""

#: src/data_fuehrung.gd:140
msgid "Du bist Kommandant eines Bunkers. Baue deine Basis aus, sammle Rohstoffe auf Expeditionen und halte an jedem siebten Tag die Flut der Schleimlinge auf."
msgstr ""

#: src/data_fuehrung.gd:141
msgid "Ziele-Leiste"
msgstr ""

#: src/data_fuehrung.gd:141
msgid "Links oben steht immer dein nächstes Ziel mit Belohnung. Ist es erfüllt, tippe auf „Abholen“ – danach erscheint das nächste."
msgstr ""

#: src/data_fuehrung.gd:142
msgid "Tutorial"
msgstr ""

#: src/data_fuehrung.gd:142
msgid "Das Tutorial führt dich mit einem Zeigefinger durch die ersten Schritte. Jeden Schritt kannst du einzeln überspringen und unter „Bedienung“ neu starten."
msgstr ""

#: src/data_fuehrung.gd:143 src/screens/settings.gd:118
msgid "Steuerung am Handy"
msgstr ""

#: src/data_fuehrung.gd:143
msgid "Linker Daumen: laufen. Gebäude antippen: verbessern, verschieben, abholen. Zwei Finger oder die Knöpfe + und −: zoomen."
msgstr ""

#: src/data_fuehrung.gd:144 src/screens/settings.gd:117
msgid "Steuerung am PC"
msgstr ""

#: src/data_fuehrung.gd:144
msgid "W A S D: laufen · Q, E, R: Fähigkeiten · F: Kommandant · Leertaste: ausweichen · T: Fahrzeug · N: nächste Welle · Esc: Pause."
msgstr ""

#: src/data_fuehrung.gd:145
msgid "Elemente und Schwächen"
msgstr ""

#: src/data_fuehrung.gd:146
msgid "Elemente"
msgstr ""

#: src/data_fuehrung.gd:146
msgid "Viele Waffen und Türme tragen ein Element: Feuer, Eis, Blitz, Gift, Wasser oder Explosion. Jede Gegnerfamilie reagiert anders darauf."
msgstr ""

#: src/data_fuehrung.gd:147
msgid "Stark und schwach"
msgstr ""

#: src/data_fuehrung.gd:147
msgid "+50 % heißt: der Treffer zählt anderthalbfach. „Wirkungslos“ heißt: dieses Element richtet keinen Schaden an. Die Tabelle unten zeigt jede Familie."
msgstr ""

#: src/data_fuehrung.gd:148
msgid "Brennen und Gift"
msgstr ""

#: src/data_fuehrung.gd:148
msgid "Feuer setzt in Brand, Gift wirkt über einige Sekunden. Beides stapelt sich nicht, wird aber erneuert."
msgstr ""

#: src/data_fuehrung.gd:149
msgid "Waffenarten"
msgstr ""

#: src/data_fuehrung.gd:150
msgid "15 Waffen je Held"
msgstr ""

#: src/data_fuehrung.gd:150
msgid "Jeder Held hat 15 Waffen: drei Startwaffen (Heldenstufe 1, 8, 16) und zwölf weitere aus Funden oder Bauplänen. Die Helden-Seite zeigt alle – auch die gesperrten mit Hinweis, wo es sie gibt."
msgstr ""

#: src/data_fuehrung.gd:151 src/screens/heroes.gd:276
msgid "Schnellwechsel"
msgstr ""

#: src/data_fuehrung.gd:151
msgid "Auf der Helden-Seite unter „Waffen“ wechselst du mit einem Tipp auf das Bild die Waffe."
msgstr ""

#: src/data_fuehrung.gd:152
msgid "Seltenheit und Stufe"
msgstr ""

#: src/data_fuehrung.gd:152
msgid "Gewöhnlich, Selten, Episch, Legendär: höhere Seltenheit bringt mehr Schaden und Zusatzwerte. In der Werkstatt verbesserst und verschmilzt du Stücke (drei gleiche → eines der nächsten Seltenheit)."
msgstr ""

#: src/data_fuehrung.gd:153 src/hud.gd:327 src/hud_guide.gd:15 src/screens.gd:39
msgid "Begleiter"
msgstr ""

#: src/data_fuehrung.gd:154
msgid "Was sie tun"
msgstr ""

#: src/data_fuehrung.gd:154
msgid "Ein Begleiter folgt deinem Helden auf Expeditionen, trägt Beute und hilft je nach Art beim Kämpfen, Heilen oder Sammeln."
msgstr ""

#: src/data_fuehrung.gd:155
msgid "Bekommen"
msgstr ""

#: src/data_fuehrung.gd:155
msgid "Manche Begleiter sitzen gefangen auf Expeditionen (Phase „Erkunden“) – befreie sie. Andere baust du aus Rohstoffen oder kaufst sie im Bildschirm „Begleiter“."
msgstr ""

#: src/data_fuehrung.gd:156
msgid "Stufen"
msgstr ""

#: src/data_fuehrung.gd:156
msgid "Begleiter sammeln Erfahrung mit jeder Ladung und jedem Kampf. Höhere Stufen tragen mehr und kämpfen besser."
msgstr ""

#: src/data_fuehrung.gd:157
msgid "Wartezeiten"
msgstr ""

#: src/data_fuehrung.gd:158
msgid "Bauzeiten"
msgstr ""

#: src/data_fuehrung.gd:158
msgid "Jeder Bau braucht eine Baudrohne und Zeit. Die ersten Bauten dauern unter einer Minute, späte Stufen Stunden."
msgstr ""

#: src/data_fuehrung.gd:159
msgid "Gratis fertig"
msgstr ""

#: src/data_fuehrung.gd:159
msgid "Liegt die Restzeit unter einer Minute, stellst du den Bau gratis fertig. Sonst kostet das Juwelen – je länger, desto mehr."
msgstr ""

#: src/data_fuehrung.gd:160
msgid "Bau-Warteschlange"
msgstr ""

#: src/data_fuehrung.gd:160
msgid "Sind alle Drohnen beschäftigt, kannst du den nächsten Auftrag vormerken. Er startet von selbst, sobald eine Drohne frei ist und die Rohstoffe reichen."
msgstr ""

#: src/data_fuehrung.gd:161
msgid "Expedition spart Zeit"
msgstr ""

#: src/data_fuehrung.gd:161
msgid "Jede Expedition zieht 15 Minuten von laufenden Bauten ab."
msgstr ""

#: src/data_fuehrung.gd:162
msgid "Juwelen gehören deinem Konto und gelten in allen deinen Städten."
msgstr ""

#: src/data_fuehrung.gd:163
msgid "Die Flut"
msgstr ""

#: src/data_fuehrung.gd:164
msgid "Jeden siebten Tag"
msgstr ""

#: src/data_fuehrung.gd:164
msgid "Am siebten Tag der Woche kommt die Flut aus zwei Richtungen. Startest du sie nicht, verteidigt sich die Basis allein (Berechnung)."
msgstr ""

#: src/data_fuehrung.gd:165 src/hud.gd:1191 src/screens/quests.gd:93
msgid "Wellen"
msgstr ""

#: src/data_fuehrung.gd:165
msgid "Die Flut kommt in Wellen. Zwischen den Wellen zeigt eine Vorschau, welche Gegnerarten als Nächstes kommen."
msgstr ""

#: src/data_fuehrung.gd:166
msgid "Schwierigkeit"
msgstr ""

#: src/data_fuehrung.gd:166
msgid "Vor dem Start wählst du Normal, Schwer oder Albtraum. Schwerer heißt: mehr und zähere Gegner, aber deutlich mehr Beute."
msgstr ""

#: src/data_fuehrung.gd:167
msgid "Verlieren"
msgstr ""

#: src/data_fuehrung.gd:167
msgid "Fällt der Bunker, gehen bis zu 20 % der gelagerten Rohstoffe verloren. Gebäude bleiben stehen, beschädigte reparieren die Handwerker."
msgstr ""

#: src/data_fuehrung.gd:168
msgid "Übung"
msgstr ""

#: src/data_fuehrung.gd:168
msgid "Der Übungsalarm (einmal am Tag) ist schwächer und kostet nichts."
msgstr ""

#: src/data_fuehrung.gd:169
msgid "Turmziele"
msgstr ""

#: src/data_fuehrung.gd:169
msgid "Tippe einen Turm an und wähle sein Ziel: nächster, stärkster, fliegend oder Boss."
msgstr ""

#: src/data_fuehrung.gd:171
msgid "Ablauf"
msgstr ""

#: src/data_fuehrung.gd:171
msgid "Ankommen → Aufbauen → Großangriff überstehen → Erkunden. Wer alle Pflichtplätze baut und den Großangriff übersteht, bekommt eine Außenbasis mit dauerhaftem Vorteil."
msgstr ""

#: src/data_fuehrung.gd:172
msgid "Rucksack"
msgstr ""

#: src/data_fuehrung.gd:172
msgid "Stell dich neben Bäume, Felsen oder Schrott, dann sammelt dein Held. Der Rucksack hat ein Gewicht; bring Ladungen ins Depot."
msgstr ""

#: src/data_fuehrung.gd:173 src/hud.gd:1396
msgid "Heimkehren"
msgstr ""

#: src/data_fuehrung.gd:173
msgid "An der Zentrale oder am Fahrzeug erscheint „Heimkehren“. Fällt dein Held, kommen Depot und halber Rucksack heim."
msgstr ""

#: src/data_fuehrung.gd:174
msgid "Gebiete"
msgstr ""

#: src/data_fuehrung.gd:174
msgid "Acht Gebiete mit eigener Gegnerfamilie. Je weiter, desto stärker die Gegner – und desto wertvoller die Beute."
msgstr ""

#: src/data_fuehrung.gd:175
msgid "Bedienung"
msgstr ""

#: src/data_liveops.gd:16
msgid "Schleimregen"
msgstr ""

#: src/data_liveops.gd:17
msgid "Es regnet Schleim! Alle Schleim-Gegner lassen doppelte Beute fallen."
msgstr ""

#: src/data_liveops.gd:18
msgid "Beute der Schleim-Familie ×2"
msgstr ""

#: src/data_liveops.gd:20
msgid "Händlerwoche"
msgstr ""

#: src/data_liveops.gd:21
msgid "Die Karawanen ziehen öfter durch die Gebiete und verkaufen alles günstiger."
msgstr ""

#: src/data_liveops.gd:22
msgid "Karawane −30 % Preis · kommt nach 15 s statt 40 s"
msgstr ""

#: src/data_liveops.gd:24
msgid "Elite-Flut"
msgstr ""

#: src/data_liveops.gd:25
msgid "In jeder Welle kommen mehr Elite-Gegner mit Krone – und sie tragen doppelte Beute."
msgstr ""

#: src/data_liveops.gd:26
msgid "+3 Elite-Gegner je Welle · Elite-Beute ×2"
msgstr ""

#: src/data_liveops.gd:28
msgid "Goldrausch"
msgstr ""

#: src/data_liveops.gd:29
msgid "Gold liegt in der Luft: Besiegte Gegner lassen 50 % mehr Münzen fallen."
msgstr ""

#: src/data_liveops.gd:30
msgid "Münzen aus Kämpfen +50 %"
msgstr ""

#: src/data_liveops.gd:32
msgid "Bauwoche"
msgstr ""

#: src/data_liveops.gd:33
msgid "Die Bautrupps legen Sonderschichten ein: Alle Bauten und Verbesserungen sind schneller fertig."
msgstr ""

#: src/data_liveops.gd:34
msgid "Bauzeit −25 %"
msgstr ""

#: src/data_liveops.gd:36
msgid "Weltboss-Woche"
msgstr ""

#: src/data_liveops.gd:37
msgid "Der Schleim-Leviathan ist erwacht! Alle Kommandanten greifen ihn gemeinsam an. Jeder Angriff zählt für den Gemeinschafts-Fortschritt."
msgstr ""

#: src/data_liveops.gd:38
msgid "Gemeinschaftskampf gegen den Schleim-Leviathan"
msgstr ""

#: src/data_liveops.gd:68 src/data_liveops.gd:149 src/data_liveops.gd:154
msgid "Halloween"
msgstr ""

#: src/data_liveops.gd:69
msgid "Kürbis-Schleime mit Hut kriechen durchs Tal, Kürbislaternen leuchten in der Basis."
msgstr ""

#: src/data_liveops.gd:71 src/data_liveops.gd:148 src/data_liveops.gd:155
msgid "Weihnachten"
msgstr ""

#: src/data_liveops.gd:72
msgid "Schnee fällt auf die Basis, Geschenke liegen unter dem Baum."
msgstr ""

#: src/data_liveops.gd:74
msgid "Ostern"
msgstr ""

#: src/data_liveops.gd:75
msgid "Auf jeder Expedition sind bunte Eier versteckt – finde alle!"
msgstr ""

#: src/data_liveops.gd:88
msgid "Rostflut"
msgstr ""

#: src/data_liveops.gd:88
msgid "Aus dem Meer der Schrottküste steigt rostiger Schleim. Wer die meisten Fluten hält, wird Rostkönig."
msgstr ""

#: src/data_liveops.gd:89
msgid "Frostfeuer"
msgstr ""

#: src/data_liveops.gd:89
msgid "Ein seltsamer Winter: Eis und Glut zugleich. Die Dämonen frieren, die Eiswesen schwitzen."
msgstr ""

#: src/data_liveops.gd:90
msgid "Sternschnuppen"
msgstr ""

#: src/data_liveops.gd:90
msgid "Sternsplitter regnen vom Himmel – und mit ihnen Schleime aus dem All."
msgstr ""

