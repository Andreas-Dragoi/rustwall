msgstr ""

#: src/data_geschichte.gd:244
msgid "Kapitel 5 · Sumpfwerk"
msgstr ""

#: src/data_geschichte.gd:244
msgid "Kapitel 6 · Frostpass"
msgstr ""

#: src/data_geschichte.gd:245
msgid "Kapitel 7 · Schleimkrater"
msgstr ""

