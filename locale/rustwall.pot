msgstr ""

#: src/data.gd:1314
msgid "Überladung"
msgstr ""

#: src/data.gd:1314
msgid "Der nächste Turm schießt 8 Sekunden doppelt so schnell."
msgstr ""

#: src/data.gd:1315
msgid "Pieps’ großer Auftritt"
msgstr ""

#: src/data.gd:1315
msgid "Die Drohne beschießt 12 Sekunden lang alles in der Nähe."
msgstr ""

#: src/data.gd:1316
msgid "Kiko, los!"
msgstr ""

#: src/data.gd:1316
msgid "Markiert den stärksten Gegner: 8 Sekunden lang +40 % Schaden von allen."
msgstr ""

#: src/data.gd:1317
msgid "Rauchfeder"
msgstr ""

#: src/data.gd:1317
msgid "4 Sekunden unsichtbar und 40 % schneller."
msgstr ""

#: src/data.gd:1318
msgid "Vogelzug"
msgstr ""

#: src/data.gd:1318
