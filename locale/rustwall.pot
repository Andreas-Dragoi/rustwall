msgid "Abschluss"
msgstr ""

#: src/data_geschichte.gd:254
msgid "Kapitel 1: Brich ins Grüntal auf"
msgstr ""

#: src/data_geschichte.gd:255
msgid "Besiege Dicker Bert im Grüntal"
msgstr ""

#: src/data_geschichte.gd:256
msgid "Kapitel 2: Folge der Spur in den Kiefernforst"
msgstr ""

#: src/data_geschichte.gd:257
msgid "Besiege die Mooskönigin im Kiefernforst"
msgstr ""

#: src/data_geschichte.gd:258
msgid "Kapitel 3: Durchquere die Staubebene"
msgstr ""

#: src/data_geschichte.gd:259
msgid "Befreie Rosa, die Händlerin, aus dem Lager der Waschbär-Diebe (Staubebene)"
msgstr ""

#: src/data_geschichte.gd:260
msgid "Besiege den Rostbrocken in der Staubebene"
msgstr ""

#: src/data_geschichte.gd:261
msgid "Kapitel 4: Erreiche die Schrottküste"
msgstr ""

#: src/data_geschichte.gd:262
msgid "Besiege Kapitän Glibber an der Schrottküste"
msgstr ""

#: src/data_geschichte.gd:263
msgid "Kapitel 5: Dringe ins Sumpfwerk vor"
msgstr ""

#: src/data_geschichte.gd:264
msgid "Befreie Professor Moosbach aus dem Schleim-Kokon (Sumpfwerk)"
msgstr ""

#: src/data_geschichte.gd:265
msgid "Besiege den Schlund im Sumpfwerk"
msgstr ""

#: src/data_geschichte.gd:266
msgid "Kapitel 6: Steige auf den Frostpass"
msgstr ""

#: src/data_geschichte.gd:267
msgid "Hacke Knut, den Schmied, aus dem Eis (Frostpass)"
msgstr ""

#: src/data_geschichte.gd:268
msgid "Besiege den Frostbrocken am Frostpass"
msgstr ""

#: src/data_geschichte.gd:269
msgid "Kapitel 7: Betritt den Schleimkrater"
msgstr ""

#: src/data_geschichte.gd:270
msgid "Stürze den Schleimkönig vom Thron"
msgstr ""

#: src/data_geschichte.gd:271
msgid "Akt 2: Setze auf die Vulkaninsel über"
msgstr ""

#: src/data_geschichte.gd:272
msgid "Besiege Magmafürst Brodel und befreie das Sternherz"
msgstr ""

#: src/data_geschichte.gd:273
msgid "Akt 3: Folge der Durchsage in die Stadtruinen"
msgstr ""

#: src/data_geschichte.gd:274
msgid "Schick Bürgermeister Bolzen in den Feierabend"
msgstr ""

#: src/data_geschichte.gd:286
msgid "Guten Morgen! Wer hat den Kaffee ausgetrunken?"
msgstr ""

#: src/data_geschichte.gd:287
msgid "Die Sonne ist wach. Ich noch nicht ganz."
msgstr ""

#: src/data_geschichte.gd:288
msgid "Frühstück vor dem Bunker – das Beste am ganzen Tag."
msgstr ""

#: src/data_geschichte.gd:289
msgid "Hat jemand die Hühner gezählt? Ich komme immer auf elf."
msgstr ""

#: src/data_geschichte.gd:290
msgid "Heute baue ich was Großes. Nach dem zweiten Brötchen."
msgstr ""

#: src/data_geschichte.gd:291
msgid "Der Tau glitzert auf den Mauern. Fast schön."
msgstr ""

#: src/data_geschichte.gd:292
msgid "Morgens riecht das Tal fast wieder wie früher."
msgstr ""

#: src/data_geschichte.gd:293
msgid "Wer zuerst am Lagerfeuer ist, kriegt die warme Bank!"
msgstr ""

#: src/data_geschichte.gd:296
msgid "Mittagspause! Endlich die Füße hochlegen."
msgstr ""

#: src/data_geschichte.gd:297
msgid "Am Lagerfeuer schmeckt sogar Rübensuppe."
msgstr ""

#: src/data_geschichte.gd:298
msgid "Noch zehn Minuten, dann geht’s weiter. Vielleicht zwanzig."
msgstr ""

#: src/data_geschichte.gd:299
msgid "Wer hat mein Butterbrot? Es war genau hier!"
msgstr ""

#: src/data_geschichte.gd:300
msgid "Die Sonne steht hoch. Die Schleimlinge halten Mittagsschlaf."
msgstr ""

#: src/data_geschichte.gd:301
msgid "Einmal Pause, bitte mit extra viel Pause."
msgstr ""

#: src/data_geschichte.gd:302
msgid "Erzählt mir keiner, dass Mauern bauen nicht hungrig macht."
msgstr ""

#: src/data_geschichte.gd:303
msgid "Ich träume von Gretas Apfelkuchen."
msgstr ""

#: src/data_geschichte.gd:306
msgid "Die Laternen gehen an. Jetzt ist es gemütlich."
msgstr ""

#: src/data_geschichte.gd:307
msgid "Was für ein Tag. Morgen wird es noch besser."
msgstr ""

#: src/data_geschichte.gd:308
msgid "Seht ihr den Himmel? Ganz orange."
msgstr ""

#: src/data_geschichte.gd:309
msgid "Wer hält heute Nachtwache? Ich nicht!"
msgstr ""

#: src/data_geschichte.gd:310
msgid "Noch schnell die Werkzeuge wegräumen."
msgstr ""

#: src/data_geschichte.gd:311
msgid "Abends höre ich das Tal atmen. Klingt friedlich."
msgstr ""

#: src/data_geschichte.gd:312
msgid "Gute Arbeit heute, Leute!"
msgstr ""

#: src/data_geschichte.gd:313
msgid "Gleich gibt’s Abendbrot. Ich rieche Bratkartoffeln."
msgstr ""

#: src/data_geschichte.gd:316
msgid "Psst! Die anderen schlafen schon."
msgstr ""

#: src/data_geschichte.gd:317
msgid "Ich hab da draußen was glucksen hören …"
msgstr ""

#: src/data_geschichte.gd:318
msgid "Sterne über dem Bunker. Wie früher."
msgstr ""

#: src/data_geschichte.gd:319
msgid "Ich dreh noch eine Runde an der Mauer."
msgstr ""

#: src/data_geschichte.gd:320
msgid "Gähn. Noch eine Runde, dann ins Bett."
msgstr ""

#: src/data_geschichte.gd:321
msgid "Nachts sind die Mauern höher. Glaube ich."
msgstr ""

#: src/data_geschichte.gd:324
msgid "Regen! Hoffentlich nicht wieder elf Tage."
msgstr ""

#: src/data_geschichte.gd:325
msgid "Meine Socken sind nass. Alle beide."
msgstr ""

#: src/data_geschichte.gd:326
msgid "Schleimlinge lieben Regen. Ich nicht."
msgstr ""

#: src/data_geschichte.gd:327
msgid "Wer hat das Fenster offen gelassen?"
msgstr ""

#: src/data_geschichte.gd:328
msgid "Pitsch, patsch – die Pfützen werden immer größer."
msgstr ""

#: src/data_geschichte.gd:329
msgid "Wenigstens müssen die Blumen nicht gegossen werden."
msgstr ""

#: src/data_geschichte.gd:330
msgid "Ich hoffe, Ada hat ihre Maschine ausgeschaltet."
msgstr ""

#: src/data_geschichte.gd:331
msgid "Regen auf dem Blechdach klingt wie Applaus."
msgstr ""

#: src/data_geschichte.gd:332
msgid "Schnell, unter das Vordach!"
msgstr ""

#: src/data_geschichte.gd:333
msgid "Ein Regenbogen wäre jetzt das Mindeste."
msgstr ""

#: src/data_geschichte.gd:336
msgid "Was für ein Wetter! Da baut es sich gleich doppelt so gut."
msgstr ""

#: src/data_geschichte.gd:337
msgid "Die Bienen sind zurück. Das ist ein gutes Zeichen."
msgstr ""

#: src/data_geschichte.gd:338
msgid "Bei Sonne glänzen sogar die alten Mauern."
msgstr ""

#: src/data_geschichte.gd:339
msgid "Heute ist ein Tag zum Wäscheaufhängen."
msgstr ""

#: src/data_geschichte.gd:340
msgid "Hörst du die Vögel? Früher war es hier so still."
msgstr ""

#: src/data_geschichte.gd:341
msgid "Sonne auf der Nase – herrlich."
msgstr ""

#: src/data_geschichte.gd:342
msgid "Bei dem Wetter kommt kein Schleimling aus seinem Loch."
msgstr ""

#: src/data_geschichte.gd:343
msgid "Ich glaube, heute wird ein guter Tag."
msgstr ""

#: src/data_geschichte.gd:346
msgid "Die Flut kommt bald. Sind die Mauern dicht?"
msgstr ""

#: src/data_geschichte.gd:347
msgid "Ich habe die Türme dreimal geputzt. Sicher ist sicher."
msgstr ""

#: src/data_geschichte.gd:348
msgid "Noch ein, zwei Tage. Dann schwappt es wieder."
msgstr ""

#: src/data_geschichte.gd:349
msgid "Mein Bauch sagt: Flut. Mein Kopf sagt: Mauern!"
msgstr ""

#: src/data_geschichte.gd:350
msgid "Wer noch Steine hat, bitte zur Mauer bringen!"
msgstr ""

#: src/data_geschichte.gd:351
msgid "Ich habe schon mal Platz im Bunker gemacht."
msgstr ""

#: src/data_geschichte.gd:352
msgid "Die Hühner sind so unruhig. Die spüren das."
msgstr ""

#: src/data_geschichte.gd:353
msgid "Lass uns noch einen Turm bauen. Nur zur Sicherheit."
msgstr ""

#: src/data_geschichte.gd:354
msgid "Diesmal halten wir sie auf. Ganz bestimmt."
msgstr ""

#: src/data_geschichte.gd:355
msgid "Ich hab die Sandsäcke gezählt. Es könnten mehr sein."
msgstr ""

#: src/data_geschichte.gd:358
msgid "Heute ist Fluttag! Alle auf ihre Plätze!"
msgstr ""

#: src/data_geschichte.gd:359
msgid "Hörst du das Schmatzen? Sie kommen!"
msgstr ""

#: src/data_geschichte.gd:360
msgid "Ich verstecke mich im Bunker. Rein strategisch."
msgstr ""

#: src/data_geschichte.gd:361
msgid "Zeig’s ihnen! Wir halten dir den Rücken frei."
msgstr ""

#: src/data_geschichte.gd:362
msgid "Die Glocke! Alle Mann an die Mauern!"
msgstr ""

#: src/data_geschichte.gd:363
msgid "Mutig sein. Und dann ganz schnell in den Bunker."
msgstr ""

#: src/data_geschichte.gd:364
msgid "Heute brauchen die Türme jede Kugel."
msgstr ""

#: src/data_geschichte.gd:365
msgid "Viel Glück! Wir zählen auf dich!"
msgstr ""

#: src/data_geschichte.gd:368
msgid "Gewonnen! Habt ihr die Schleimlinge rennen sehen?"
msgstr ""

#: src/data_geschichte.gd:369
msgid "Das war knapp. Aber wir stehen noch!"
msgstr ""

#: src/data_geschichte.gd:370
msgid "Hoch lebe der Bunker! Hoch lebe unser Held!"
msgstr ""

#: src/data_geschichte.gd:371
msgid "Ich hab nicht gezittert. Höchstens ein bisschen."
msgstr ""

#: src/data_geschichte.gd:372
msgid "So eine Flut steckt unsere Mauer locker weg."
msgstr ""

#: src/data_geschichte.gd:373
msgid "Heute Abend wird gefeiert!"
msgstr ""

#: src/data_geschichte.gd:374
msgid "Die Glocke hat geläutet – die Post ist angekommen!"
msgstr ""

#: src/data_geschichte.gd:375
msgid "Unglaublich, wie du die abgewehrt hast!"
msgstr ""

#: src/data_geschichte.gd:376
msgid "Die Türme haben gesungen. Bumm, bumm, bumm!"
msgstr ""

#: src/data_geschichte.gd:377
msgid "Nächste Woche gleich noch mal? Na gut."
msgstr ""

#: src/data_geschichte.gd:380
msgid "Oje, die Mauer hat ein Loch. Ein großes."
msgstr ""

#: src/data_geschichte.gd:381
msgid "Wer repariert das? Ach so, ich."
msgstr ""

#: src/data_geschichte.gd:382
msgid "Mein schönes Gebäude! Ganz verbeult."
msgstr ""

#: src/data_geschichte.gd:383
msgid "Schleim überall. Das dauert, bis das sauber ist."
msgstr ""

#: src/data_geschichte.gd:384
msgid "Hammer und Nägel her – wir flicken das!"
msgstr ""

#: src/data_geschichte.gd:385
msgid "Die haben ganz schön zugebissen."
msgstr ""

#: src/data_geschichte.gd:386
msgid "Nächstes Mal bauen wir die Mauer doppelt."
msgstr ""

#: src/data_geschichte.gd:387
msgid "Das sieht schlimmer aus, als es ist. Hoffe ich."
msgstr ""

#: src/data_geschichte.gd:388
msgid "Ein paar Bretter, ein bisschen Mut – wird schon."
msgstr ""

#: src/data_geschichte.gd:389
msgid "Wer hat hier draufgesabbert? Ach, die Schleimlinge."
msgstr ""

#: src/data_geschichte.gd:392
msgid "Ich hätte da einen kleinen Wunsch …"
msgstr ""

#: src/data_geschichte.gd:393
msgid "Wenn du mal Zeit hast: Ich wünsche mir was!"
msgstr ""

#: src/data_geschichte.gd:394
msgid "Nur ein kleiner Wunsch. Ganz klein. Versprochen."
msgstr ""

#: src/data_geschichte.gd:395
msgid "Hast du meinen Wunsch gesehen? Das Herz über mir!"
msgstr ""

#: src/data_geschichte.gd:396
msgid "Ein Wunsch, und ich bin der glücklichste Bewohner im Tal."
msgstr ""

#: src/data_geschichte.gd:397
msgid "Ich träume von etwas Schönem für unsere Basis."
msgstr ""

#: src/data_geschichte.gd:400
msgid "Holz vor der Hütte! Na ja, vor dem Sägewerk."
msgstr ""

#: src/data_geschichte.gd:401
msgid "Achtung, Baum fällt! Kleiner Scherz."
msgstr ""

#: src/data_geschichte.gd:402
msgid "Jeder Baum wächst nach. Ich pass auf."
msgstr ""

#: src/data_geschichte.gd:403
msgid "Sägespäne im Haar – das ist mein Duft."
msgstr ""

#: src/data_geschichte.gd:406
msgid "Stein auf Stein, so muss das sein."
msgstr ""

#: src/data_geschichte.gd:407
msgid "Diese Schubkarre quietscht wie ein Schleimling."
msgstr ""

#: src/data_geschichte.gd:408
msgid "Aus diesem Stein wird mal eine Mauer. Eine schöne."
msgstr ""

#: src/data_geschichte.gd:409
msgid "Granit, Basalt, Kiesel – ich liebe sie alle."
msgstr ""

#: src/data_geschichte.gd:412
msgid "Das ist kein Müll, das ist ein Ersatzteil!"
msgstr ""

#: src/data_geschichte.gd:413
msgid "Aus drei kaputten Dingen mach ich ein ganzes."
msgstr ""

#: src/data_geschichte.gd:414
msgid "Die Presse frisst alles. Fast so wie die Schleimlinge."
msgstr ""

#: src/data_geschichte.gd:415
msgid "Ich habe eine Radkappe gefunden. Meine neue Lieblingsradkappe."
msgstr ""

#: src/data_geschichte.gd:418
msgid "Wenn es summt, ist es gut. Wenn es brummt, ist es schlecht."
msgstr ""

#: src/data_geschichte.gd:419
msgid "Ich hab die Kabel sortiert. Nach Farben."
msgstr ""

#: src/data_geschichte.gd:420
msgid "Ohne Zellen keine Türme. Ohne mich keine Zellen."
msgstr ""

#: src/data_geschichte.gd:421
msgid "Puh. Wer hat den Generator so warm gemacht?"
msgstr ""

#: src/data_geschichte.gd:424
msgid "Kisten tragen ist wie Sport. Nur ohne Pause."
msgstr ""

#: src/data_geschichte.gd:425
msgid "Links, rechts, Lager. Links, rechts, Lager."
msgstr ""

#: src/data_geschichte.gd:426
msgid "Wer hat das so schwer gepackt?"
msgstr ""

#: src/data_geschichte.gd:427
msgid "Ich trage alles. Außer schlechte Laune."
msgstr ""

#: src/data_geschichte.gd:430
msgid "Ich halte die Augen offen. Alle beide."
msgstr ""

#: src/data_geschichte.gd:431
msgid "Nichts zu sehen. Gut so."
msgstr ""

#: src/data_geschichte.gd:432
msgid "Da hinten! … Ach, nur ein Busch."
msgstr ""

#: src/data_geschichte.gd:433
msgid "Wache halten ist wichtig. Und langweilig."
msgstr ""

#: src/data_geschichte.gd:434
msgid "Keiner kommt hier durch. Außer dir natürlich."
msgstr ""

#: src/data_geschichte.gd:437
msgid "Blumen machen Mut. Glaub mir."
msgstr ""

#: src/data_geschichte.gd:438
msgid "Die Tulpen wachsen schneller als die Mauern."
msgstr ""

#: src/data_geschichte.gd:439
msgid "Ein bisschen Grün tut dem Bunker gut. Das gute Grün."
msgstr ""

#: src/data_geschichte.gd:440
msgid "Wer hat in mein Beet getreten? Schleimspuren!"
msgstr ""

#: src/data_geschichte.gd:443
msgid "Das hier wird mein Meisterwerk."
msgstr ""

#: src/data_geschichte.gd:444
msgid "Erst messen, dann bauen. Oder umgekehrt?"
msgstr ""

#: src/data_geschichte.gd:445
msgid "Noch ein Brett, noch ein Nagel, fertig."
msgstr ""

#: src/data_geschichte.gd:446
msgid "Die Drohnen sind fleißig. Ich auch!"
msgstr ""

#: src/data_geschichte.gd:449
msgid "Kaputt? Gib her, das krieg ich hin."
msgstr ""

#: src/data_geschichte.gd:450
msgid "Ein bisschen Kleber, ein bisschen Liebe."
msgstr ""

#: src/data_geschichte.gd:451
msgid "Reparieren ist wie Bauen, nur mit mehr Seufzen."
msgstr ""

#: src/data_geschichte.gd:452
msgid "Wieder heile. Na ja, fast."
msgstr ""

#: src/data_geschichte.gd:455
msgid "Schön, dass du da bist!"
msgstr ""

#: src/data_geschichte.gd:456
msgid "Ich habe gehört, im Krater wohnt ein Stern."
msgstr ""

#: src/data_geschichte.gd:457
msgid "Wenn das hier vorbei ist, feiern wir das Talfest."
msgstr ""

#: src/data_geschichte.gd:458
msgid "Hast du schon die neuen Mauern gesehen?"
msgstr ""

#: src/data_geschichte.gd:459
msgid "Jona hat mir einen Brief gebracht. Von mir an mich."
msgstr ""

#: src/data_geschichte.gd:460
msgid "Weißt du, was ich vermisse? Langeweile."
msgstr ""

#: src/data_geschichte.gd:461
msgid "Früher war hier ein Spielplatz. Bruno baut ihn wieder auf."
msgstr ""

#: src/data_geschichte.gd:462
msgid "Ich übe schon mal fürs Feuerwerk. Nur mit Wunderkerzen."
msgstr ""

#: src/data_geschichte.gd:463
msgid "Unser Bunker ist der schönste im ganzen Tal."
msgstr ""

#: src/data_geschichte.gd:464
msgid "Manchmal winke ich den Schleimlingen. Die winken nie zurück."
msgstr ""

#: src/data_geschichte.gd:465
msgid "Ich glaube, die Hühner planen etwas."
msgstr ""

#: src/data_geschichte.gd:466
msgid "Wenn ich groß bin, werde ich Held. Ich bin schon groß."
msgstr ""

#: src/data_geschichte.gd:467
msgid "Wer pfeift da? Ach, der Wind in der Antenne."
msgstr ""

#: src/data_geschichte.gd:468
msgid "Rohstoffe, Rohstoffe, Rohstoffe. Ich träume schon davon."
msgstr ""

#: src/data_geschichte.gd:469
msgid "Danke, dass du auf uns aufpasst!"
msgstr ""

#: src/data_geschichte.gd:472
msgid "Oh, hallo! Ich hab dich gar nicht kommen sehen."
msgstr ""

#: src/data_geschichte.gd:473
msgid "Ja? Brauchst du was?"
msgstr ""

#: src/data_geschichte.gd:474
msgid "Keine Sorge, ich arbeite. Ganz bestimmt."
msgstr ""

#: src/data_geschichte.gd:475
msgid "Nicht kitzeln!"
msgstr ""

#: src/data_geschichte.gd:476
msgid "Alles bestens hier. Wirklich."
msgstr ""

#: src/data_geschichte.gd:477
msgid "Du bist der Chef. Sag einfach, was zu tun ist."
msgstr ""

#: src/data_geschichte.gd:478
msgid "Ich halte hier die Stellung!"
msgstr ""

#: src/data_geschichte.gd:479
msgid "Schön, dich zu sehen!"
msgstr ""

#: src/data_geschichte.gd:480
msgid "Hast du Neuigkeiten von draußen?"
msgstr ""

#: src/data_geschichte.gd:481
msgid "Pass auf dich auf da draußen."
msgstr ""

#: src/data_geschichte.gd:482
msgid "Ich hab heute schon drei Schleimlinge gesehen. Von Weitem."
msgstr ""

#: src/data_geschichte.gd:483
msgid "Wenn du einen Wunsch frei hättest – ich hätte drei."
msgstr ""

#: src/data_geschichte.gd:488
msgid "Dicker Bert ist geplatzt? Endlich!"
msgstr ""

#: src/data_geschichte.gd:488
msgid "Ein Sternsplitter, der nach Süden zeigt? Unheimlich."
msgstr ""

#: src/data_geschichte.gd:489
msgid "Der Nebel im Forst ist weg, sagt man."
msgstr ""

#: src/data_geschichte.gd:489
msgid "Bruno sucht immer noch nach Teilen von Berta."
msgstr ""

#: src/data_geschichte.gd:490
msgid "Ein Kessel, der regnet? Hab ich’s doch gewusst!"
msgstr ""

#: src/data_geschichte.gd:490
msgid "Ada sagt, sie baut nie wieder ohne Aus-Knopf."
msgstr ""

#: src/data_geschichte.gd:491
msgid "Die Matrosen von der Möwe sind wieder nett."
msgstr ""

#: src/data_geschichte.gd:491
msgid "Was liegt wohl auf dem Meeresgrund?"
msgstr ""

#: src/data_geschichte.gd:492
msgid "Die Pumpen im Sumpfwerk stehen still. Gut so!"
msgstr ""

#: src/data_geschichte.gd:492
msgid "Der Krater liebt Wasser? Dann bekommt er keins mehr."
msgstr ""

#: src/data_geschichte.gd:493
msgid "Die Zugvögel sind unterwegs! Ich hab sie gesehen!"
msgstr ""

#: src/data_geschichte.gd:493
msgid "Ein Stern im Krater … wie der wohl aussieht?"
msgstr ""

#: src/data_geschichte.gd:494
msgid "Der Schleimkönig ist weg! Aber wo ist das Herz?"
msgstr ""

#: src/data_geschichte.gd:494
msgid "Am Horizont raucht die Vulkaninsel. Gefällt mir nicht."
msgstr ""

#: src/data_geschichte.gd:495
msgid "Das Sternherz ist zurück! Ganz leise leuchtet es."
msgstr ""

#: src/data_geschichte.gd:495
msgid "Talfest! Talfest! Ich hab schon den Kuchen bestellt."
msgstr ""

#: src/data_geschichte.gd:496
msgid "In der Stadt gehen die Lichter an – für uns!"
msgstr ""

#: src/data_geschichte.gd:496
msgid "Ein Bürgermeister mit Zylinder? Und ich dachte, ich hab schon alles gesehen."
msgstr ""

#: src/data_geschichte.gd:501
msgid "Alles hat seinen Preis – außer Freundschaft. Die kostet extra."
msgstr ""

#: src/data_geschichte.gd:502
msgid "Heute im Angebot: Holz gegen Stein! Fast geschenkt!"
msgstr ""

#: src/data_geschichte.gd:503
msgid "Ich hab da noch ein Ei. Frag nicht, was drin ist."
msgstr ""

#: src/data_geschichte.gd:504
msgid "Die Waschbären haben meine besten Töpfe. Ich will sie zurück!"
msgstr ""

#: src/data_geschichte.gd:505
msgid "Handeln ist wie Tanzen. Einer tritt dem anderen auf die Füße."
msgstr ""

#: src/data_geschichte.gd:506
msgid "Für dich mache ich einen Sonderpreis. Den gleichen wie immer."
msgstr ""

#: src/data_geschichte.gd:507
msgid "Die Karawane fährt wieder, sobald die Straßen sicher sind."
msgstr ""

#: src/data_geschichte.gd:508
msgid "Ein Bunker mit Laden – jetzt seid ihr eine richtige Stadt!"
msgstr ""

#: src/data_geschichte.gd:509
msgid "Wer nicht feilscht, zahlt zu viel. Merk dir das."
msgstr ""

#: src/data_geschichte.gd:510
msgid "Danke, dass du mich da rausgeholt hast. Der Tee geht aufs Haus."
msgstr ""

#: src/data_geschichte.gd:513
msgid "Faszinierend! Der Schleim besteht zu einem Teil aus Sternenstaub."
msgstr ""

#: src/data_geschichte.gd:514
msgid "Ada war meine beste Studentin. Und meine lauteste."
msgstr ""

#: src/data_geschichte.gd:515
msgid "Bitte nicht stören, ich zähle Sporen."
msgstr ""

#: src/data_geschichte.gd:516
msgid "Mit meinen Notizen geht die Forschung viel schneller."
msgstr ""

#: src/data_geschichte.gd:517
msgid "Im Kokon hatte ich viel Zeit zum Nachdenken. Und keinen Bleistift."
msgstr ""

#: src/data_geschichte.gd:518
msgid "Der Krater ist ein Sternabdruck. Ich wusste es!"
msgstr ""

#: src/data_geschichte.gd:519
msgid "Hypothese: Schleimlinge mögen Musik. Versuch läuft."
msgstr ""

#: src/data_geschichte.gd:520
msgid "Wissenschaft ist, wenn man trotzdem weitermacht."
msgstr ""

#: src/data_geschichte.gd:521
msgid "Hast du schon einmal einen Schleimling von innen gesehen? Ich schon."
msgstr ""

#: src/data_geschichte.gd:522
msgid "Ein Labor im Bunker – herrlich! Fast wie zu Hause."
msgstr ""

#: src/data_geschichte.gd:525
msgid "Gutes Eisen. Gutes Feuer. Gute Waffe."
msgstr ""

#: src/data_geschichte.gd:526
msgid "Bring mir deine Waffen. Ich mache sie besser. Und billiger."
msgstr ""

#: src/data_geschichte.gd:527
msgid "Mein Deckel liegt noch am Frostpass. Er war zu groß."
msgstr ""

#: src/data_geschichte.gd:528
msgid "Kalt war’s im Eis. Jetzt ist mir warm."
msgstr ""

#: src/data_geschichte.gd:529
msgid "Hm."
msgstr ""

#: src/data_geschichte.gd:530
msgid "Ein Hammer löst die meisten Probleme. Der Rest braucht zwei."
msgstr ""

#: src/data_geschichte.gd:531
msgid "Obsidian. Damit baue ich dir eine Mauer, die hält."
msgstr ""

#: src/data_geschichte.gd:532
msgid "Ich rede nicht viel. Ich schmiede."
msgstr ""

#: src/data_geschichte.gd:533
msgid "Danke. Für das mit dem Eis."
msgstr ""

#: src/data_geschichte.gd:534
msgid "Der Amboss singt heute. Hörst du?"
msgstr ""

#: src/data_geschichte.gd:542
msgid "Jona, hast du den Helm auf?"
msgstr ""

#: src/data_geschichte.gd:542
msgid "Ich trag doch einen."
msgstr ""

#: src/data_geschichte.gd:542
msgid "Den richtigen! Mit Brille!"
msgstr ""

#: src/data_geschichte.gd:543
msgid "Funke, bitte nichts anzünden, was wir noch brauchen."
msgstr ""

#: src/data_geschichte.gd:543
msgid "Ich zünde nur an, was schleimt."
msgstr ""

#: src/data_geschichte.gd:543
msgid "Das ist fast alles."
msgstr ""

#: src/data_geschichte.gd:544
msgid "Bruno, Pieps sagt, du hast dein Butterbrot vergessen."
msgstr ""

#: src/data_geschichte.gd:544 src/data_geschichte.gd:561
msgid "Geht schon."
msgstr ""

#: src/data_geschichte.gd:544
msgid "Er bringt es dir. Er fliegt schon los."
msgstr ""

#: src/data_geschichte.gd:545
msgid "Ada, bitte keine neuen Erfindungen unterwegs."
msgstr ""

#: src/data_geschichte.gd:545
msgid "Nur eine kleine."
msgstr ""

#: src/data_geschichte.gd:545
msgid "Ich hol schon mal den Werkzeugkasten."
msgstr ""

#: src/data_geschichte.gd:546
msgid "Yuki, siehst du was?"
msgstr ""

#: src/data_geschichte.gd:546
msgid "Drei Nester, zwei Kisten und einen sehr dicken Schleimling."
msgstr ""

#: src/data_geschichte.gd:546
msgid "Ich hab nur gefragt, ob du was siehst."
msgstr ""

#: src/data_geschichte.gd:547
msgid "Oma Greta, hast du genug Raketen dabei?"
msgstr ""

#: src/data_geschichte.gd:547
msgid "Kind, ich hab immer genug Raketen dabei."
msgstr ""

#: src/data_geschichte.gd:547
msgid "Das macht mir ein bisschen Angst."
msgstr ""

#: src/data_geschichte.gd:548
msgid "Nele, Kiko hat Möwen gezählt. Vierzehn."
msgstr ""

#: src/data_geschichte.gd:548
msgid "Und Schleimlinge?"
msgstr ""

#: src/data_geschichte.gd:548
msgid "Die hat er aufgegeben."
msgstr ""

#: src/data_geschichte.gd:549
msgid "Jona, bring Äpfel mit, wenn du welche siehst."
msgstr ""

#: src/data_geschichte.gd:549
msgid "Ich bin Held, nicht Gemüsehändler."
msgstr ""

#: src/data_geschichte.gd:549
msgid "Kein Apfel, kein Kuchen."
msgstr ""

#: src/data_geschichte.gd:549
msgid "… Ich schau mal."
msgstr ""

#: src/data_geschichte.gd:550
msgid "Mika, im Forst nichts abfackeln. Da steht Berta."
msgstr ""

#: src/data_geschichte.gd:550
msgid "Ich pass auf deinen Bagger auf."
msgstr ""

#: src/data_geschichte.gd:550
msgid "Danke."
msgstr ""

#: src/data_geschichte.gd:551
msgid "Bruno, hörst du was?"
msgstr ""

#: src/data_geschichte.gd:551
msgid "Ein Motor. Ganz leise."
msgstr ""

#: src/data_geschichte.gd:551
msgid "Das ist dein Herz, Bruno."
msgstr ""

#: src/data_geschichte.gd:551
msgid "… Vielleicht beides."
msgstr ""

#: src/data_geschichte.gd:552
msgid "Ada, ist das nicht die Gegend, wo dein Labor stand?"
msgstr ""

#: src/data_geschichte.gd:552
msgid "Zwei Wände und ein Kühlschrank."
msgstr ""

#: src/data_geschichte.gd:552
msgid "Und das Käsebrot?"
msgstr ""

#: src/data_geschichte.gd:552
msgid "Lass es bitte liegen."
msgstr ""

#: src/data_geschichte.gd:553
msgid "Yuki, die Spur ins Meer – hast du sie aufgeschrieben?"
msgstr ""

#: src/data_geschichte.gd:553
msgid "Jede Feder, jede Pfütze."
msgstr ""

#: src/data_geschichte.gd:553
msgid "Gut. Irgendwann tauchen wir da runter."
msgstr ""

#: src/data_geschichte.gd:554
msgid "Nele, die Taucherglocke ist fertig."
msgstr ""

#: src/data_geschichte.gd:554
msgid "Singst du wieder, wenn wir runterfahren?"
msgstr ""

#: src/data_geschichte.gd:554
msgid "Nur, wenn du nicht zuhörst."
msgstr ""

#: src/data_geschichte.gd:555
msgid "Greta, im Sumpfwerk soll ein Fass Zimt stehen."
msgstr ""

#: src/data_geschichte.gd:555
msgid "Ich weiß. Ich hole es."
msgstr ""

#: src/data_geschichte.gd:555
msgid "Für den Kuchen?"
msgstr ""

#: src/data_geschichte.gd:555
msgid "Für den größten Kuchen der Welt."
msgstr ""

#: src/data_geschichte.gd:556
msgid "Mika, deine Wehr wartet auf dem Fabrikdach!"
msgstr ""

#: src/data_geschichte.gd:556
msgid "Fünf Helme, Oma Greta. Ich hab sie alle geputzt."
msgstr ""

#: src/data_geschichte.gd:556
msgid "Dann hol sie heim, Kind."
msgstr ""

#: src/data_geschichte.gd:557
msgid "Yuki, Pieps misst minus zwanzig Grad."
msgstr ""

#: src/data_geschichte.gd:557
msgid "Die Vögel frieren nicht. Sie warten."
msgstr ""

#: src/data_geschichte.gd:557
msgid "Worauf?"
msgstr ""

#: src/data_geschichte.gd:557
msgid "Auf uns, glaube ich."
msgstr ""

#: src/data_geschichte.gd:558
msgid "Jona … falls es meine Schuld ist …"
msgstr ""

#: src/data_geschichte.gd:558
msgid "Ada. Wer Regen machen kann, kann ihn auch abstellen."
msgstr ""

#: src/data_geschichte.gd:558
msgid "Das hat Greta auch gesagt."
msgstr ""

#: src/data_geschichte.gd:559
msgid "Ada, Kind, du schaffst das."
msgstr ""

#: src/data_geschichte.gd:559
msgid "Und wenn nicht?"
msgstr ""

#: src/data_geschichte.gd:559
msgid "Dann backe ich trotzdem einen Kuchen."
msgstr ""

#: src/data_geschichte.gd:560
msgid "Greta, da drüben ist Obsidian. Für Mauern."
msgstr ""

#: src/data_geschichte.gd:560
msgid "Und für Raketen-Startrampen."
msgstr ""

#: src/data_geschichte.gd:560
msgid "Natürlich."
msgstr ""

#: src/data_geschichte.gd:561
msgid "Bruno, es ist heiß da draußen. Trink was!"
msgstr ""

#: src/data_geschichte.gd:561
msgid "Bruno!"
msgstr ""

#: src/data_geschichte.gd:561
msgid "… Ich trink was."
msgstr ""

#: src/data_geschichte.gd:562
msgid "Ada, kriegst du die Generatoren wieder an?"
msgstr ""

#: src/data_geschichte.gd:562
msgid "Ich hab schon ganz andere Sachen angekriegt."
msgstr ""

#: src/data_geschichte.gd:562
msgid "Genau das macht mir Sorgen."
msgstr ""

#: src/data_geschichte.gd:563
msgid "Jona, da drüben steht ein Bagger auf zwei Beinen."
msgstr ""

#: src/data_geschichte.gd:563
msgid "Ist das Berta?"
msgstr ""

#: src/data_geschichte.gd:563
msgid "Nein. Berta hat Manieren."
msgstr ""

#: src/data_geschichte.gd:567
msgid "Hier Bunker! Pass auf dich auf da draußen!"
msgstr ""

#: src/data_geschichte.gd:568
msgid "Funkcheck: Hörst du mich? Gut. Viel Glück!"
msgstr ""

#: src/data_geschichte.gd:569
msgid "Bring was Schönes mit – und dich selbst in einem Stück!"
msgstr ""

#: src/data_geschichte.gd:570
msgid "Wir halten hier die Stellung. Du schaffst das!"
msgstr ""

#: src/data_geschichte.gd:573
msgid "Im Grüntal laufen alle Schleimspuren nach Süden. Folg ihnen!"
msgstr ""

#: src/data_geschichte.gd:574
msgid "Im Kiefernforst: leise gehen, nicht rennen!"
msgstr ""

#: src/data_geschichte.gd:575
msgid "Staubebene: Halt Ausschau nach dem Lager der Waschbär-Diebe!"
msgstr ""

#: src/data_geschichte.gd:576
msgid "Schrottküste: Die Matrosen tun nichts. Meistens."
msgstr ""

#: src/data_geschichte.gd:577
msgid "Im Sumpfwerk soll ein Professor im Schleim stecken. Hol ihn raus!"
msgstr ""

#: src/data_geschichte.gd:578
msgid "Am Frostpass ist ein Schmied eingefroren. Nimm was zum Hacken mit!"
msgstr ""

#: src/data_geschichte.gd:579
msgid "Der Krater … sei vorsichtig. Wirklich vorsichtig."
msgstr ""

#: src/data_geschichte.gd:580
msgid "Vulkaninsel: Schau auf die Risse – die glühen, bevor die Lava kommt!"
msgstr ""

#: src/data_geschichte.gd:581
msgid "Stadtruinen: Auf den Dächern bist du sicher vor den Mähern. Und halt an roten Ampeln – die Maschinen tun es auch!"
msgstr ""

#: src/data_geschichte.gd:584
msgid "Verstanden. Ich bin unterwegs!"
msgstr ""

#: src/data_geschichte.gd:585
msgid "Alles klar. Bis später!"
msgstr ""

#: src/data_geschichte.gd:586
msgid "Mach dir keine Sorgen. Ich komme heil zurück."
msgstr ""

#: src/data_geschichte.gd:587
msgid "Wird gemacht!"
msgstr ""

#: src/data_geschichte.gd:601
msgid "Gering"
msgstr ""

#: src/data_geschichte.gd:604
msgid "Ein Schleimnest umgangen"
msgstr ""

#: src/data_geschichte.gd:605
msgid "Eine Fundkiste geborgen"
msgstr ""

#: src/data_geschichte.gd:606
msgid "Ein Rudel Schleimlinge vertrieben"
msgstr ""

#: src/data_geschichte.gd:607
msgid "Am Lagerfeuer übernachtet und gut geschlafen"
msgstr ""

#: src/data_geschichte.gd:608
msgid "Einen Rastplatz voller Rohstoffe gefunden"
msgstr ""

#: src/data_geschichte.gd:609
msgid "Einem verirrten Bewohner den Heimweg gezeigt"
msgstr ""

#: src/data_geschichte.gd:610
msgid "Eine alte Vorratskammer geplündert"
msgstr ""

#: src/data_geschichte.gd:611
msgid "Zwei Fundkisten hinter einem Felsen entdeckt"
msgstr ""

#: src/data_geschichte.gd:612
msgid "Ein Begleiter-Ei in einem verlassenen Nest gefunden"
msgstr ""

#: src/data_geschichte.gd:615
msgid "Äpfel am alten Baum hinter dem Bach gepflückt"
msgstr ""

#: src/data_geschichte.gd:615
msgid "Die Mühle läuft wieder – Frieda hat Brot mitgegeben"
msgstr ""

#: src/data_geschichte.gd:616
msgid "Im Nebel verlaufen – aber wieder herausgefunden"
msgstr ""

#: src/data_geschichte.gd:616
msgid "Ein gelbes Baggerteil für Bruno gefunden"
msgstr ""

#: src/data_geschichte.gd:617
msgid "Sandsturm überstanden"
msgstr ""

#: src/data_geschichte.gd:617
msgid "Kaktuswasser gezapft und schneller gelaufen"
msgstr ""

#: src/data_geschichte.gd:618
msgid "Bei Ebbe ein Wrack durchsucht"
msgstr ""

#: src/data_geschichte.gd:618
msgid "Die Matrosen der Möwe haben freundlich gewunken"
msgstr ""

#: src/data_geschichte.gd:619
msgid "Giftnebel ausgewichen"
msgstr ""

#: src/data_geschichte.gd:619
msgid "Ein Fass mit seltsamem Zimt gefunden"
msgstr ""

#: src/data_geschichte.gd:620
msgid "Einer Lawine entkommen"
msgstr ""

#: src/data_geschichte.gd:620
msgid "Mit den Zugvögeln auf dem Pass gerastet"
msgstr ""

#: src/data_geschichte.gd:621
msgid "Meteorschauer überstanden"
msgstr ""

#: src/data_geschichte.gd:621
msgid "Sternsplitter aus einem Geysir gefischt"
msgstr ""

#: src/data_geschichte.gd:622
msgid "Über einen Lavastrom gesprungen"
msgstr ""

#: src/data_geschichte.gd:622
msgid "Im Schatten eines Obsidianfelsens abgekühlt"
msgstr ""

#: src/data_geschichte.gd:623
msgid "Mit der U-Bahn quer durch die Stadt gefahren"
msgstr ""

#: src/data_geschichte.gd:623
msgid "Von einem Dach aus die Mäher gezählt"
msgstr ""

#: src/data_geschichte.gd:626
msgid "Vom Dicken Bert überrascht"
msgstr ""

#: src/data_geschichte.gd:626
msgid "Von der Mooskönigin umrankt"
msgstr ""

#: src/data_geschichte.gd:626
msgid "Vom Rostbrocken umgerannt"
msgstr ""

#: src/data_geschichte.gd:626
msgid "Von Kapitän Glibber über Bord geworfen"
msgstr ""

#: src/data_geschichte.gd:627
msgid "Vom Schlund angeknabbert"
msgstr ""

#: src/data_geschichte.gd:627
msgid "Vom Frostbrocken eingeschneit"
msgstr ""

#: src/data_geschichte.gd:627
msgid "Vom Schleimkönig angefaucht"
msgstr ""

#: src/data_geschichte.gd:627
msgid "Von Magmafürst Brodel angesengt"
msgstr ""

#: src/data_geschichte.gd:628
msgid "Von Bürgermeister Bolzen verwarnt"
msgstr ""

