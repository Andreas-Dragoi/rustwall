msgstr ""

#: src/data.gd:1430
msgid "Dünenbuggy"
msgstr ""

#: src/data.gd:1430
msgid "Buggy"
msgstr ""

#: src/data.gd:1430
msgid "Rammt kleine Gegner ohne Tempoverlust."
msgstr ""

#: src/data.gd:1431
msgid "Pritsche"
msgstr ""

#: src/data.gd:1431
msgid "Pickup mit Geschütz"
msgstr ""

#: src/data.gd:1431
