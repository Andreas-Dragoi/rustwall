msgid "Kapitel 8 · Vulkaninsel"
msgstr ""

#: src/data_geschichte.gd:247
msgid "Kapitel 9 · Stadtruinen"
msgstr ""

#: src/data_geschichte.gd:249
msgid "Ankunft"
msgstr ""

#: src/data_geschichte.gd:249
msgid "Nach dem Bosssieg"
msgstr ""

